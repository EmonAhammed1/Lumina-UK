<style>
  #technology-scientific-foundation {
    padding: 80px 0;
    background-color: var(--color-bg, #000);
    text-align: center;
  }
  .tech-sci-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 30px;
    color: var(--g-color-heading, #fff);
  }
  .tech-sci-body {
    max-width: 800px;
    margin: 0 auto 40px;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-body-text, #FAF6F0);
  }
  .tech-sci-credibility {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
    margin-bottom: 40px;
  }
  .tech-sci-cred-item {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 150px;
  }
  .tech-sci-cred-item img {
    max-width: 100%;
    height: auto;
    filter: grayscale(100%);
    opacity: 0.7;
    transition: all 0.3s;
  }
  .tech-sci-cred-item img:hover {
    filter: grayscale(0%);
    opacity: 1;
  }
  .tech-sci-cred-text {
    font-size: 0.9rem;
    color: var(--color-body-text, #FAF6F0);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .tech-sci-btn {
    display: inline-block;
    padding: 12px 30px;
    background-color: transparent;
    border: 1px solid #fff;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
  }
  .tech-sci-btn:hover {
    background-color: #fff;
    color: #000;
    transform: translateY(-2px);
  }
</style>

<div id="technology-scientific-foundation" data-section-id="{{ section.id }}">
  <div class="container">
    <div data-aos="fade-up" data-aos-duration="700">
      {% if section.settings.heading != blank %}
        <h2 class="tech-sci-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="tech-sci-body">{{ section.settings.text }}</div>
      {% endif %}
      
      {% if section.blocks.size > 0 %}
        <div class="tech-sci-credibility">
          {% for block in section.blocks %}
            <div class="tech-sci-cred-item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.text | escape }}" loading="lazy">
              {% else %}
                <span class="tech-sci-cred-text">{{ block.settings.text }}</span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
      
      {% if section.settings.enable_button and section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="tech-sci-btn">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Tech Scientific Found",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Developed with Scientific Precision"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>Lumina Europa works with specialist technology and formulation partners to bring advanced nanofibre skincare into a refined, accessible ritual. Further information about the technology, ingredients and supporting documentation will be introduced as the Lumina scientific library develops.</p>"
    },
    {
      "type": "checkbox",
      "id": "enable_button",
      "label": "Enable Library Button",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore Our Scientific Library"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "credibility-item",
      "name": "Credibility Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text (if no image)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Technology Scientific Foundation"
    }
  ]
}
{% endschema %}
