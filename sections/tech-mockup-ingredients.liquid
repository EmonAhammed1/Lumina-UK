<script>
  function openIngrModal(blockId) {
    const modal = document.getElementById('ingr-modal-' + blockId);
    if (modal) {
      modal.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    }
  }
  
  function closeIngrModal(blockId) {
    const modal = document.getElementById('ingr-modal-' + blockId);
    if (modal) {
      modal.classList.remove('is-active');
      document.body.style.overflow = '';
    }
  }
  
  function scrollIngrModal(blockId, direction) {
    const scroll = document.getElementById('ingr-scroll-' + blockId);
    if (scroll) {
      scroll.scrollBy({ left: scroll.offsetWidth * direction, behavior: 'smooth' });
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('#shopify-section-{{ section.id }}');
    if (!section) return;
    
    const scrollContainer = section.querySelector('.tm-ingr-scroll');
    const prevBtns = section.querySelectorAll('.tm-ingr-arrow-prev, .tm-ingr-arrow-prev-desktop');
    const nextBtns = section.querySelectorAll('.tm-ingr-arrow-next, .tm-ingr-arrow-next-desktop');
    
    if (scrollContainer) {
      prevBtns.forEach(btn => btn.addEventListener('click', () => {
        scrollContainer.scrollBy({ left: -scrollContainer.offsetWidth, behavior: 'smooth' });
      }));
      nextBtns.forEach(btn => btn.addEventListener('click', () => {
        scrollContainer.scrollBy({ left: scrollContainer.offsetWidth, behavior: 'smooth' });
      }));
    }
  });
</script>
