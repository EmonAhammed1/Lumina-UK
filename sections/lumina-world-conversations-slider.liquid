<!-- sections/lumina-world-conversations-slider.liquid -->
<style>
  .lumina-slider-section {
    background-color: #040404;
    color: #ffffff;
    position: relative;
    padding: 70px 0;
    width: 100%;
    border-top: 1px solid rgba(197, 160, 89, 0.25);
    border-bottom: 1px solid rgba(197, 160, 89, 0.25);
    overflow: hidden;
    scroll-margin-top: 90px;
  }

  .lwcs-container {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 45px;
    box-sizing: border-box;
  }

  /* Header Bar */
  .lwcs-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 35px;
  }

  .lwcs-header-label {
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #c5a059;
    font-weight: 500;
    opacity: 0.9;
  }

  .lwcs-view-all-link {
    color: #c5a059;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
  }

  .lwcs-view-all-link:hover {
    color: #d8b26a;
    transform: translateX(3px);
  }

  /* Header Right Group with Nav Buttons */
  .lwcs-header-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .lwcs-nav-btns {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lwcs-nav-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(197, 160, 89, 0.4);
    background: rgba(10, 10, 10, 0.8);
    color: #c5a059;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .lwcs-nav-btn:hover {
    background: #c5a059;
    color: #000000;
    border-color: #c5a059;
  }

  .lwcs-nav-btn svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  /* Slider Track & Cards */
  .lwcs-slider-wrap {
    position: relative;
    width: 100%;
  }

  .lwcs-cards-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
    width: 100%;
  }

  .lwcs-card {
    display: flex;
    flex-direction: column;
    position: relative;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .lwcs-card:hover {
    transform: translateY(-4px);
  }

  /* Media Frame */
  .lwcs-media-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: #0d0d0d;
    border: 1px solid rgba(197, 160, 89, 0.25);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 16px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.5);
    transition: border-color 0.3s ease;
  }

  .lwcs-card:hover .lwcs-media-frame {
    border-color: rgba(197, 160, 89, 0.6);
  }

  .lwcs-media-frame img,
  .lwcs-media-frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .lwcs-card:hover .lwcs-media-frame img {
    transform: scale(1.04);
  }

  /* Play Button Icon */
  .lwcs-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid #c5a059;
    background: rgba(5, 5, 5, 0.55);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 0 15px rgba(197, 160, 89, 0.3);
    z-index: 2;
  }

  .lwcs-card:hover .lwcs-play-btn {
    transform: translate(-50%, -50%) scale(1.12);
    background: #c5a059;
  }

  .lwcs-play-btn svg {
    width: 14px;
    height: 14px;
    fill: #c5a059;
    margin-left: 2px;
    transition: fill 0.3s ease;
  }

  .lwcs-card:hover .lwcs-play-btn svg {
    fill: #000000;
  }

  /* Text Content */
  .lwcs-card-info {
    display: flex;
    flex-direction: column;
  }

  .lwcs-category {
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #c5a059;
    font-weight: 600;
    margin-bottom: 6px;
    opacity: 0.9;
  }

  .lwcs-name {
    font-family: var(--g-font-2), "Cormorant Garamond", "Times New Roman", serif;
    font-size: 17px;
    font-weight: 500;
    color: #ffffff;
    margin: 0 0 4px 0;
    line-height: 1.25;
  }

  .lwcs-role {
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.55);
    font-weight: 300;
  }

  /* Video Modal Backdrop */
  .lwcs-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(8px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .lwcs-modal-backdrop.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lwcs-modal-box {
    position: relative;
    width: 90%;
    max-width: 900px;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid rgba(197, 160, 89, 0.4);
    box-shadow: 0 0 50px rgba(197, 160, 89, 0.2);
    border-radius: 4px;
    overflow: hidden;
  }

  .lwcs-modal-box video,
  .lwcs-modal-box iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .lwcs-modal-close {
    position: absolute;
    top: -45px;
    right: 0;
    color: #c5a059;
    font-size: 28px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 5px;
    transition: color 0.3s ease;
  }

  .lwcs-modal-close:hover {
    color: #ffffff;
  }

  .lwcs-bottom-nav {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 24px;
  }

  /* Responsive Slider Horizontal Scroll on Smaller Screens */
  @media (max-width: 1200px) {
    .lwcs-cards-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 991px) {
    .lumina-slider-section { padding: 50px 0; }
    .lwcs-container { padding: 0 20px; }
    .lwcs-cards-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 15px;
      -webkit-overflow-scrolling: touch;
    }
    .lwcs-card {
      flex: 0 0 220px;
      scroll-snap-align: start;
    }
    .lwcs-cards-grid::-webkit-scrollbar {
      height: 4px;
    }
    .lwcs-cards-grid::-webkit-scrollbar-thumb {
      background: #c5a059;
      border-radius: 2px;
    }
  }

  @media (max-width: 767px) {
    .lwcs-header-nav-btns {
      display: none !important;
    }
    .lwcs-bottom-nav {
      display: flex !important;
    }
  }

  @media (max-width: 575px) {
    .lwcs-card {
      flex: 0 0 180px;
    }
  }
</style>

<div id="meet-the-team" class="lumina-slider-section">
  <div class="lwcs-container">

    <!-- Section Header -->
    <div class="lwcs-header-bar">
      {%- if section.settings.section_title != blank -%}
        <div class="lwcs-header-label">{{ section.settings.section_title }}</div>
      {%- endif -%}

      <div class="lwcs-header-right">
        {%- if section.settings.view_all_label != blank -%}
          <a href="{{ section.settings.view_all_link | default: '#' }}" class="lwcs-view-all-link">
            {{ section.settings.view_all_label }} &rarr;
          </a>
        {%- endif -%}

        <div class="lwcs-nav-btns lwcs-header-nav-btns">
          <button class="lwcs-nav-btn" onclick="scrollLuminaSlider('prev')" aria-label="Previous">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button class="lwcs-nav-btn" onclick="scrollLuminaSlider('next')" aria-label="Next">
            <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Cards Grid / Slider -->
    <div class="lwcs-slider-wrap">
      <div class="lwcs-cards-grid">
        {%- for block in section.blocks -%}
          <div class="lwcs-card" data-video-url="{{ block.settings.video_url }}">

            <div class="lwcs-media-frame">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}" loading="lazy" draggable="false">
              {%- else -%}
                {%- assign mod_idx = forloop.index | modulo: 5 | plus: 1 -%}
                {%- assign fallback_speaker = 'lumina-world-hero-' | append: mod_idx | append: '.png' -%}
                <img src="{{ fallback_speaker | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy" draggable="false">
              {%- endif -%}

              <div class="lwcs-play-btn" onclick="event.stopPropagation(); openLuminaVideoModal('{% if block.settings.video_url != blank %}{% if block.settings.video_url contains "http" %}{{ block.settings.video_url }}{% else %}{{ block.settings.video_url | file_url }}{% endif %}{% else %}{{ '4_lumina_world_conversations_modal.mp4' | file_url }}{% endif %}')">
                <svg viewBox="0 0 24 24"><polygon points="8 5 19 12 8 19 8 5"></polygon></svg>
              </div>
            </div>

            <div class="lwcs-card-info">
              {%- if block.settings.category != blank -%}
                <div class="lwcs-category">{{ block.settings.category }}</div>
              {%- endif -%}
              {%- if block.settings.name != blank -%}
                <h3 class="lwcs-name">{{ block.settings.name }}</h3>
              {%- endif -%}
              {%- if block.settings.role != blank -%}
                <div class="lwcs-role">{{ block.settings.role }}</div>
              {%- endif -%}
            </div>

          </div>
        {%- endfor -%}
      </div>

      <!-- Bottom Navigation for Mobile -->
      <div class="lwcs-bottom-nav">
        <button class="lwcs-nav-btn" onclick="scrollLuminaSlider('prev')" aria-label="Previous">
          <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="lwcs-nav-btn" onclick="scrollLuminaSlider('next')" aria-label="Next">
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>

  </div>
</div>

<!-- Global Video Modal -->
<div class="lwcs-modal-backdrop" id="lwcs-video-modal" onclick="closeLuminaVideoModal(event)">
  <div class="lwcs-modal-box" onclick="event.stopPropagation()">
    <button class="lwcs-modal-close" onclick="closeLuminaVideoModal(event)">&times;</button>
    <video id="lwcs-modal-player" controls autoplay>
      <source id="lwcs-modal-source" src="" type="video/mp4">
    </video>
  </div>
</div>

<script>
  function scrollLuminaSlider(direction) {
    var grid = document.querySelector('.lwcs-cards-grid');
    if (!grid) return;
    var card = grid.querySelector('.lwcs-card');
    var cardWidth = card ? card.offsetWidth + 16 : 240;
    var scrollAmount = direction === 'next' ? cardWidth * 2 : -cardWidth * 2;
    grid.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  }

  function openLuminaVideoModal(videoUrl) {
    var modal = document.getElementById('lwcs-video-modal');
    var player = document.getElementById('lwcs-modal-player');
    var source = document.getElementById('lwcs-modal-source');
    
    if (modal && player && source) {
      source.src = videoUrl;
      player.load();
      modal.classList.add('active');
      player.play().catch(function(e){ console.log(e); });
    }
  }

  function closeLuminaVideoModal(e) {
    if (e) e.stopPropagation();
    var modal = document.getElementById('lwcs-video-modal');
    var player = document.getElementById('lwcs-modal-player');
    if (modal && player) {
      player.pause();
      modal.classList.remove('active');
    }
  }

  // Smooth Drag to Scroll for Mobile & Desktop Finger Touch
  document.addEventListener('DOMContentLoaded', function() {
    var grid = document.querySelector('.lwcs-cards-grid');
    if (!grid) return;
    
    var isDown = false;
    var startX;
    var scrollLeft;

    grid.addEventListener('mousedown', function(e) {
      isDown = true;
      grid.classList.add('dragging');
      startX = e.pageX - grid.offsetLeft;
      scrollLeft = grid.scrollLeft;
    });

    grid.addEventListener('mouseleave', function() { isDown = false; grid.classList.remove('dragging'); });
    grid.addEventListener('mouseup', function() { isDown = false; grid.classList.remove('dragging'); });
    
    grid.addEventListener('mousemove', function(e) {
      if(!isDown) return;
      e.preventDefault();
      var x = e.pageX - grid.offsetLeft;
      var walk = (x - startX) * 1.5;
      grid.scrollLeft = scrollLeft - walk;
    });
  });
</script>

