{% render 'golden-hour-vars' %}
<style>
  #shopify-section-{{ section.id }} .tm-htu-wrap {
    padding: 100px 24px;
    background-color: #000;
  }
  .tm-htu-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-wrap: nowrap;
    gap: 40px;
    align-items: center;
  }
  .tm-htu-left {
    flex: 0 0 300px;
  }
  .tm-htu-subtitle {
    font-size: 11px;
    letter-spacing: 0.15em;
    color: var(--gh-golden);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .tm-htu-title {
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    color: var(--gh-golden);
    font-family: serif;
    font-weight: 300;
    line-height: 1.1;
    margin-bottom: 32px;
  }
  .tm-htu-link {
    font-size: 11px;
    color: var(--gh-golden);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 24px;
    border: 1px solid var(--gh-border-gold);
    transition: all 0.3s ease;
  }
  .tm-htu-link:hover {
    background: rgba(249, 226, 156, 0.1);
  }
  .tm-htu-link svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .tm-htu-right {
    flex: 1;
    min-width: 0;
  }
  .tm-htu-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }
  @media screen and (max-width: 1200px) {
    .tm-htu-grid { grid-template-columns: repeat(3, 1fr); row-gap: 40px; }
  }
  @media screen and (max-width: 900px) {
    .tm-htu-container { flex-direction: column; }
    .tm-htu-left { flex: none; text-align: center; margin-bottom: 40px; }
  }
  @media screen and (max-width: 480px) {
    .tm-htu-grid { grid-template-columns: repeat(2, 1fr); row-gap: 40px; }
  }
  .tm-htu-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
  }
  /* The Arrow */
  .tm-htu-step:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -14px;
    top: 50px; /* Aligned with the center of the 100x100 icon */
    transform: translateY(-50%);
    font-size: 16px;
    color: rgba(249, 226, 156, 0.5);
  }
  @media screen and (max-width: 1200px) {
    .tm-htu-step:nth-child(3n)::after { display: none; }
  }
  @media screen and (max-width: 480px) {
    .tm-htu-step:nth-child(2n)::after { display: none; }
  }
  .tm-htu-icon {
    width: 100px;
    height: 100px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    overflow: hidden;
  }
  @media screen and (max-width: 768px) {
    .tm-htu-icon {
      width: 80px;
      height: 80px;
    }
    .tm-htu-step:not(:last-child)::after {
      top: 40px;
    }
  }
  .tm-htu-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }
  .tm-htu-icon svg {
    width: 100%;
    height: 100%;
    stroke: var(--gh-golden);
    fill: none;
    stroke-width: 1;
  }
  .tm-htu-step-number {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--gh-golden);
    margin-bottom: 8px;
  }
  .tm-htu-step-title {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gh-golden);
    margin-bottom: 8px;
  }
  .tm-htu-step-desc {
    font-size: 11px;
    color: var(--gh-text-muted);
    line-height: 1.4;
    max-width: 180px;
  }
</style>

<div id="technology-how-to-use" class="tm-htu-wrap">
  <div class="tm-htu-container">
    <div class="tm-htu-left">
      <div class="tm-htu-subtitle">{{ section.settings.subtitle }}</div>
      <h2 class="tm-htu-title">{{ section.settings.title }}</h2>
      {% if section.settings.btn_label != blank %}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="tm-htu-link">
          <svg viewBox="0 0 24 24"><path d="M5 3l14 9-14 9V3z" fill="currentColor" stroke="none"/></svg>
          {{ section.settings.btn_label }}
        </a>
      {% endif %}
    </div>

    <div class="tm-htu-right">
      <div class="tm-htu-grid">
        {% for block in section.blocks %}
          <div class="tm-htu-step" {{ block.shopify_attributes }}>
            <div class="tm-htu-icon">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.title }}" loading="lazy">
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}
                    <img src="{{ '1._unfold.png' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                  {% when 2 %}
                    <img src="{{ '2._activate.png' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                  {% when 3 %}
                    <img src="{{ '3apply.jpg' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                  {% when 4 %}
                    <img src="{{ '5._remove.png' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                  {% when 5 %}
                    <img src="{{ '6._finish.png' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                  {% else %}
                    <img src="{{ '1._unfold.png' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                {% endcase %}
              {% endif %}
            </div>
            <div class="tm-htu-step-title">{{ block.settings.title }}</div>
            <div class="tm-htu-step-desc">{{ block.settings.text }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mockup - How To Use",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "HOW TO USE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "A simple ritual. Remarkable results."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "WATCH THE HOW-TO VIDEO"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Line Art Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "STEP"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mockup - How To Use",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "UNFOLD",
            "text": "Remove mask from sachet."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "ACTIVATE",
            "text": "Spray with water or Lumina Mist."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "APPLY",
            "text": "Place on clean face and smooth gently."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "REST",
            "text": "Relax for 15-20 minutes."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "REMOVE",
            "text": "Lift off the mask and discard."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "CONTINUE",
            "text": "Gently pat in remaining essence. No rinse."
          }
        }
      ]
    }
  ]
}
{% endschema %}
