{% render 'golden-hour-vars' %}
{%- style -%}
  #shopify-section-{{ section.id }} .gh-what-wrap {
    background-color: var(--gh-dark-bg);
    color: var(--gh-text-light);
    display: flex;
    align-items: stretch;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .gh-what-image-col {
    flex: 0 0 {{ section.settings.image_width_percent }}%;
    max-width: {{ section.settings.image_width_percent }}%;
    min-height: {{ section.settings.section_height_desktop }}px;
    position: relative;
  }
  #shopify-section-{{ section.id }} .gh-what-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    inset: 0;
  }
  #shopify-section-{{ section.id }} .gh-what-content-col {
    flex: 1;
    display: flex;
    align-items: center;
    position: relative;
    padding: {{ section.settings.padding_top_desktop }}px {{ section.settings.padding_side_desktop }}px {{ section.settings.padding_bottom_desktop }}px;
  }
  @media screen and (max-width: 990px) {
    #shopify-section-{{ section.id }} .gh-what-wrap {
      flex-direction: column;
    }
    #shopify-section-{{ section.id }} .gh-what-image-col {
      flex: 0 0 auto;
      max-width: 100%;
      width: 100%;
      min-height: {{ section.settings.section_height_mobile }}px;
    }
    #shopify-section-{{ section.id }} .gh-what-content-col {
      padding: {{ section.settings.padding_top_mobile }}px 24px {{ section.settings.padding_bottom_mobile }}px;
    }
  }
  .gh-what-text-col {
    max-width: 600px;
    position: relative;
    z-index: 2;
  }
  .gh-what-heading-small {
    font-size: 12px;
    letter-spacing: 0.15em;
    color: var(--gh-text-muted);
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .gh-what-heading {
    font-size: {{ section.settings.heading_size_desktop }}px;
    color: var(--gh-golden);
    margin-bottom: 32px;
    font-weight: 300;
    font-family: serif;
    line-height: 1.3;
  }
  @media screen and (max-width: 1024px) {
    .gh-what-heading {
      font-size: calc({{ section.settings.heading_size_desktop }}px * 0.85);
      margin-bottom: 24px;
    }
  }
  @media screen and (max-width: 990px) {
    .gh-what-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
      margin-bottom: 20px;
    }
  }
  .gh-what-heading strong,
  .gh-what-heading b {
    font-weight: 600;
  }
  .gh-what-body {
    font-size: {{ section.settings.body_size_desktop }}px;
    line-height: 1.6;
    color: var(--gh-text-muted);
    margin-bottom: 32px;
  }
  @media screen and (max-width: 1024px) {
    .gh-what-body {
      font-size: calc({{ section.settings.body_size_desktop }}px * 0.9);
    }
  }
  @media screen and (max-width: 990px) {
    .gh-what-body {
      font-size: {{ section.settings.body_size_mobile }}px;
    }
  }
  .gh-what-link {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--gh-golden);
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: var(--gh-transition);
  }
  .gh-what-link:hover {
    opacity: 0.7;
  }
  .gh-what-graphic {
    position: absolute;
    right: {{ section.settings.padding_side_desktop | minus: 40 }}px;
    top: 50%;
    transform: translateY(-50%);
    width: {{ section.settings.graphic_width }}px;
    height: {{ section.settings.graphic_height }}px;
    opacity: {{ section.settings.graphic_opacity | times: 1.0 | divided_by: 100 }};
    pointer-events: none;
    z-index: 1;
  }
  .gh-what-graphic img {
    /* Neutralizes a solid/dark matte baked into an uploaded raster image so it
       blends into the section background instead of showing as a hard-edged box.
       Harmless no-op if the uploaded file is already a transparent PNG/SVG. */
    mix-blend-mode: screen;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  @media screen and (max-width: 1200px) {
    .gh-what-graphic {
      width: {{ section.settings.graphic_width | times: 0.7 }}px;
      height: {{ section.settings.graphic_height | times: 0.7 }}px;
      right: 10px;
    }
  }
  @media screen and (max-width: 990px) {
    .gh-what-graphic {
      display: none;
    }
  }
{%- endstyle -%}

<div class="gh-what-wrap" id="{{ section.id | split: '__' | last }}" data-section-id="{{ section.id }}">
  <div class="gh-what-image-col">
    {%- if section.settings.main_image != blank -%}
      <img src="{{ section.settings.main_image | image_url: width: 1600 }}" class="gh-what-video" alt="{{ section.settings.heading | escape }}" loading="lazy">
    {%- elsif section.settings.video != blank and section.settings.video.sources != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'gh-what-video' }}
    {%- elsif section.settings.video != blank -%}
      <video class="gh-what-video" autoplay loop muted playsinline poster="{{ 'The Golden Hour Mock.png' | asset_url }}">
        <source src="{% if section.settings.video contains 'http' %}{{ section.settings.video }}{% else %}{{ section.settings.video | file_url }}{% endif %}" type="video/mp4">
        <source src="{{ 'video 3 natural light on the skin.mp4' | file_url }}" type="video/mp4">
        <source src="{{ 'video_3_natural_light_on_the_skin.mp4' | file_url }}" type="video/mp4">
        <source src="{{ 'demonstrative animation.mp4' | file_url }}" type="video/mp4">
        <source src="{{ 'video 1 presentation.mp4' | file_url }}" type="video/mp4">
      </video>
    {%- else -%}
      <video class="gh-what-video" autoplay loop muted playsinline poster="{{ 'The Golden Hour Mock.png' | asset_url }}">
        <source src="{{ 'video 3 natural light on the skin.mp4' | file_url }}" type="video/mp4">
        <source src="{{ 'video_3_natural_light_on_the_skin.mp4' | file_url }}" type="video/mp4">
        <source src="{{ 'demonstrative animation.mp4' | file_url }}" type="video/mp4">
        <source src="{{ 'demonstrative_animation.mp4' | file_url }}" type="video/mp4">
        <source src="{{ 'video 1 presentation.mp4' | file_url }}" type="video/mp4">
      </video>
    {%- endif -%}
  </div>

  <div class="gh-what-content-col">
    <div class="gh-what-graphic">
      {%- if section.settings.decorative_image != blank -%}
        <img src="{{ section.settings.decorative_image | image_url: width: 800 }}" alt="" style="width: 100%; height: auto; object-fit: contain;">
      {%- else -%}
        <img src="{{ 'section-i.png' | asset_url }}" alt="" style="width: 100%; height: auto; object-fit: contain;">
      {%- endif -%}
    </div>

    <div class="gh-what-text-col">
      <div class="gh-what-heading-small">CE ESTE GOLDEN HOUR?</div>
      {%- if section.settings.heading != blank -%}
        <h2 class="gh-what-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="gh-what-body">
        {{ section.settings.content }}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url | default: '#' }}" class="gh-what-link">
          {{ section.settings.link_label }} &rarr;
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Golden Hour - What Is It",
  "settings": [
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum Width (px)",
      "min": 800,
      "max": 2000,
      "step": 50,
      "default": 1450
    },
    {
      "type": "range",
      "id": "image_width_percent",
      "label": "Image Column Width (%)",
      "min": 30,
      "max": 60,
      "step": 1,
      "default": 42
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image (Left)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Accompanying Video (Fallback)"
    },
    {
      "type": "image_picker",
      "id": "decorative_image",
      "label": "Decorative Graphic Image (Optional, overrides default flower graphic)"
    },
    {
      "type": "range",
      "id": "graphic_width",
      "label": "Decorative Graphic Width (px)",
      "min": 100,
      "max": 500,
      "step": 10,
      "default": 220
    },
    {
      "type": "range",
      "id": "graphic_height",
      "label": "Decorative Graphic Height (px)",
      "min": 100,
      "max": 500,
      "step": 10,
      "default": 220
    },
    {
      "type": "range",
      "id": "graphic_opacity",
      "label": "Decorative Graphic Opacity (%)",
      "min": 5,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Golden Hour is that moment when the light becomes softer and time seems to slow down."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content (Romanian)",
      "default": "<p>We created this community to keep that same feel: a place where every release, every ritual, and every story reaches first those who choose to be part of the Lumina universe.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link Label",
      "default": "DISCOVER OUR PHILOSOPHY"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Desktop Settings"
    },
    {
      "type": "range",
      "id": "section_height_desktop",
      "label": "Section Height (Desktop px)",
      "min": 300,
      "max": 800,
      "step": 10,
      "default": 480
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading Size (Desktop px)",
      "min": 24,
      "max": 56,
      "step": 2,
      "default": 36
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "label": "Body Text Size (Desktop px)",
      "min": 14,
      "max": 28,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Content Top Padding (Desktop px)",
      "min": 20,
      "max": 180,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Content Bottom Padding (Desktop px)",
      "min": 20,
      "max": 180,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_side_desktop",
      "label": "Content Side Padding (Desktop px)",
      "min": 40,
      "max": 160,
      "step": 10,
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Image Height (Mobile px)",
      "min": 200,
      "max": 500,
      "step": 10,
      "default": 320
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size (Mobile px)",
      "min": 18,
      "max": 36,
      "step": 1,
      "default": 26
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Body Text Size (Mobile px)",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top Padding (Mobile px)",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom Padding (Mobile px)",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Golden Hour - What Is It"
    }
  ]
}
{% endschema %}
