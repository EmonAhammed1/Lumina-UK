{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .product-recommendations .product-card .product-countdown{display:none !important;}
  {%- if section.settings.nowrap -%}
    .section-{{ section.id }}-padding{
      overflow:hidden;
    }
   .product-recommendations .swiper-container {
        overflow: visible;
    }
  {%- endif -%}

  .product-recommendations-curated .swiper-button-prev {
    top: 26% !important;
    left: -50px !important;
  }
  .product-recommendations-curated .swiper-button-next {
    top: 26% !important;
    right: -50px !important;
  }
{%- endstyle -%}
<div class="section-{{ section.id }}-padding" data-aos="{{ section.settings.animation }}" >
  <div class="{{ section.settings.setwidth }}">
    {%- assign filter_keys = "pentru_cine,moment_ritual,parfum,conservanti,ingrediente,tip_ten,beneficiu,tip_produs" | split: "," -%}
    {%- assign mask_matches = "" -%}
    {%- assign protocol_matches = "" -%}

    {%- paginate collections.all.products by 200 -%}
      {%- for p in collections.all.products -%}
        {%- if p.handle == product.handle -%}{%- continue -%}{%- endif -%}

        {%- assign score = 0 -%}
        {%- for key in filter_keys -%}
          {%- assign cur_val = product.metafields.filter[key].value | join: ',' | default: product.metafields.filter[key].value -%}
          {%- assign p_val = p.metafields.filter[key].value | join: ',' | default: p.metafields.filter[key].value -%}
          {%- if cur_val != blank and p_val != blank and cur_val == p_val -%}
            {%- assign score = score | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if score > 0 -%}
          {%- assign tip_produs = p.metafields.filter.tip_produs.value | downcase -%}
          {%- assign score_str = score | prepend: '00' | slice: -2, 2 -%}
          {%- assign match_entry = score_str | append: '|' | append: p.handle | append: ';;;' -%}
          
          {%- if tip_produs contains 'protocol' -%}
            {%- assign protocol_matches = protocol_matches | append: match_entry -%}
          {%- else -%}
            {%- assign mask_matches = mask_matches | append: match_entry -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endpaginate -%}

    {%- assign sorted_masks = mask_matches | split: ';;;' | sort | reverse -%}
    {%- assign sorted_protocols = protocol_matches | split: ';;;' | sort | reverse -%}

    {%- if mask_matches != blank or protocol_matches != blank -%}
      <div class="product-recommendations-curated">
        <h2 class="product-recommendations__heading mb-5 text-{{ section.settings.heading_align }} {{ section.settings.heading_size }}">Continue the Ritual</h2>
        
        {%- if mask_matches != blank -%}
          <div class="curated-row mb-5 swiper-wrapper-{{ section.id }}-masks" style="position: relative;">
            <div class="swiper-container swipercol-{{ section.id }}-masks product-grid" 
              data-id="{{ section.id }}-masks"  
              data-perview-desktop="{{ section.settings.perviewDesktop }}"
              data-space-between="{{ section.settings.spaceBetween }}" role="list">
              <div class="swiper-wrapper">
                {% for entry in sorted_masks limit: 10 %}
                  {%- if entry == blank -%}{%- continue -%}{%- endif -%}
                  {%- assign parts = entry | split: '|' -%}
                  {%- assign handle = parts[1] -%}
                  {%- assign recommendation = all_products[handle] -%}
                  {%- if recommendation != blank -%}
                    <div class="grid__item swiper-slide">
                      {%- assign custom_title = recommendation.metafields.custom.recommendation_title | default: recommendation.title -%}
                      {%- render 'product-card', product: recommendation, custom_title: custom_title -%}
                    </div>
                  {%- endif -%}
                {% endfor %}
              </div>
            </div>
            {%- if section.settings.arrows -%}
              <div class="swiper-button-prev"></div>
              <div class="swiper-button-next"></div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if protocol_matches != blank -%}
          <div class="curated-row mb-5 swiper-wrapper-{{ section.id }}-protocols" style="position: relative;">
            <div class="swiper-container swipercol-{{ section.id }}-protocols product-grid" 
              data-id="{{ section.id }}-protocols"  
              data-perview-desktop="{{ section.settings.perviewDesktop }}"
              data-space-between="{{ section.settings.spaceBetween }}" role="list">
              <div class="swiper-wrapper">
                {% for entry in sorted_protocols limit: 10 %}
                  {%- if entry == blank -%}{%- continue -%}{%- endif -%}
                  {%- assign parts = entry | split: '|' -%}
                  {%- assign handle = parts[1] -%}
                  {%- assign recommendation = all_products[handle] -%}
                  {%- if recommendation != blank -%}
                    <div class="grid__item swiper-slide">
                      {%- assign custom_title = recommendation.metafields.custom.recommendation_title | default: recommendation.title -%}
                      {%- render 'product-card', product: recommendation, custom_title: custom_title -%}
                    </div>
                  {%- endif -%}
                {% endfor %}
              </div>
            </div>
            {%- if section.settings.arrows -%}
              <div class="swiper-button-prev"></div>
              <div class="swiper-button-next"></div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% javascript %}
 
document.addEventListener('DOMContentLoaded', function() {
    const swiperContainers = document.querySelectorAll('.product-recommendations-curated .swiper-container');
    swiperContainers.forEach(function(swiperContainer) {
      const spaceBetween = parseInt(swiperContainer.getAttribute('data-space-between'), 10) || 20;
      const perviewDesktop = parseInt(swiperContainer.getAttribute('data-perview-desktop'), 10) || 4;
      
      new Swiper(swiperContainer, {
        slidesPerView: "auto",
        spaceBetween: spaceBetween,
        breakpoints: {
          320: { slidesPerView: 2, spaceBetween: 20 },
          768: { slidesPerView: 3 },
          992: { slidesPerView: perviewDesktop }
        },
        navigation: {
          nextEl: swiperContainer.parentElement.querySelector(".swiper-button-next"),
          prevEl: swiperContainer.parentElement.querySelector(".swiper-button-prev"),
        }
      });
    });
  });

{% endjavascript %}

