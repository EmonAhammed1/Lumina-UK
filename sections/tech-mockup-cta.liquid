{% render 'golden-hour-vars' %}
<style>
  #shopify-section-{{ section.id }} .tm-cta-wrap {
    position: relative;
    background-color: #000;
    display: flex;
    align-items: center;
    min-height: 450px;
    padding: 80px 24px;
    overflow: hidden;
  }
  .tm-cta-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .tm-cta-image img, .tm-cta-image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
  }
  .tm-cta-image::after {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to right, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.5) 40%, transparent 100%);
  }
  .tm-cta-container {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: flex-start;
  }
  .tm-cta-content {
    max-width: 600px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .tm-cta-title {
    font-size: clamp(1.8rem, 2.5vw, 2.5rem);
    color: var(--gh-golden);
    font-family: serif;
    font-weight: 300;
    line-height: 1.3;
    margin-bottom: 32px;
    text-transform: uppercase;
  }
  .tm-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    background-color: #F9D633;
    border: 1px solid #F9D633;
    color: #000;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .tm-cta-btn:hover {
    background-color: #000;
    border-color: #F9D633;
    color: #F9D633;
  }
  @media screen and (max-width: 768px) {
    .tm-cta-wrap {
      min-height: 400px;
      align-items: flex-end;
      padding-bottom: 40px;
    }
    .tm-cta-image::after {
      background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 50%, transparent 100%);
    }
    .tm-cta-container {
      justify-content: center;
    }
    .tm-cta-content {
      max-width: 100%;
    }
    .tm-cta-title {
      font-size: 1.5rem;
    }
  }
</style>

<div id="{{ section.id | split: '__' | last }}" class="tm-cta-wrap">
  <div class="tm-cta-image">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="Lumina Products" loading="lazy">
    {% else %}
      <img src="{{ 'Screenshot_2026-03-31_at_14.31.38.png' | asset_url }}" alt="Lumina Products" loading="lazy">
    {% endif %}
  </div>
  
  <div class="tm-cta-container">
    <div class="tm-cta-content">
      <h2 class="tm-cta-title">{{ section.settings.title | newline_to_br }}</h2>
      
      {% if section.settings.btn_label != blank %}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="tm-cta-btn">
          {{ section.settings.btn_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mockup - CTA",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "TECHNOLOGY ONLY MATTERS WHEN IT BECOMES PART OF YOUR RITUAL."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "EXPLORE LUMINA COLLECTION"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Mockup - CTA"
    }
  ]
}
{% endschema %}
