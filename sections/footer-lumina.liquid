    <!-- GOLDEN HOUR NEWSLETTER COLUMN -->
    <div class="lf-col-gh">
      <h2 class="lf-gh-title">{{ section.settings.gh_title | default: 'LUMINA<br>GOLDEN HOUR' }}</h2>
      <p class="lf-gh-text">{{ section.settings.gh_text1 | default: 'A moment of the day when light becomes warmer, rarer, and closer to your skin.' }}</p>
      <p class="lf-gh-text">{{ section.settings.gh_text2 | default: 'Here begins the rituals, stories, and gestures you discover before anyone else.' }}</p>
      
      {%- form 'customer', class: 'lf-newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="hidden" name="return_to" value="/pages/golden-hour">
        <div class="lf-input-group">
          <input type="email" name="contact[email]" placeholder="{{ section.settings.newsletter_placeholder | default: 'Your email address' }}" required>
          <svg class="lf-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
        </div>
        <button type="submit" class="lf-submit-btn">
          {{ section.settings.newsletter_btn_text | default: 'ENTER GOLDEN HOUR' }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      {%- endform -%}
      
