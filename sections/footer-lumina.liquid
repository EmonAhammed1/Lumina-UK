{% render 'golden-hour-vars' %}
<style>
  .lumina-footer-wrapper {
    background-color: var(--gh-dark-bg);
    color: var(--gh-text-muted);
    font-family: var(--gh-font-family, sans-serif);
    padding: 60px 5% 40px;
    position: relative;
    overflow: hidden;
  }
  .lumina-footer-wrapper a {
    color: var(--gh-text-muted);
    text-decoration: none;
    transition: var(--gh-transition);
  }
  .lumina-footer-wrapper a:hover {
    color: var(--gh-golden);
  }

  /* TOP SECTION */
  .lf-top-section {
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--gh-border-gold);
    position: relative;
    z-index: 2;
  }

  /* Left Column: Logo */
  .lf-col-logo {
    flex: 0 0 200px;
    padding-right: 40px;
  }
  .lf-logo-title {
    font-size: 28px;
    color: var(--gh-golden);
    font-weight: 300;
    margin: 0;
    letter-spacing: 0.1em;
    font-family: serif;
  }
  .lf-logo-subtitle {
    font-size: 12px;
    color: var(--gh-golden);
    letter-spacing: 0.25em;
    margin-top: 5px;
    text-transform: uppercase;
  }
  .lf-logo-divider {
    width: 30px;
    height: 1px;
    background-color: var(--gh-golden);
    margin: 20px 0;
  }
  .lf-tagline {
    font-size: 16px;
    color: var(--gh-golden);
    line-height: 1.6;
    margin-bottom: 40px;
  }
  .lf-copyright {
    font-size: 12px;
    line-height: 1.5;
  }

  /* Middle Columns: Links */
  .lf-col-links-wrapper {
    display: flex;
    flex: 1;
    border-left: 1px solid var(--gh-border-gold);
  }
  .lf-col-links {
    flex: 1;
    padding: 0 30px;
    border-right: 1px solid var(--gh-border-gold);
  }
  .lf-col-title {
    font-size: 12px;
    color: var(--gh-golden);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 25px;
    font-weight: 600;
  }
  .lf-accordion-icon {
    display: none;
    width: 14px;
    height: 14px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    transition: transform 0.3s ease;
  }
  .lf-col-subtitle {
    font-size: 11px;
    color: var(--gh-golden);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 30px;
    margin-bottom: 15px;
  }
  .lf-menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .lf-menu-list li {
    margin-bottom: 15px;
    font-size: 13px;
    display: flex;
    align-items: center;
  }
  .lf-icon-external {
    width: 12px;
    height: 12px;
    margin-left: 5px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
  }

  /* Right Column: Golden Hour */
  .lf-col-gh {
    flex: 0 0 320px;
    padding-left: 40px;
  }
  .lf-gh-title {
    font-size: 24px;
    color: var(--gh-golden);
    font-family: serif;
    font-weight: 300;
    line-height: 1.2;
    margin: 0 0 20px;
  }
  .lf-gh-text {
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 20px;
  }
  
  .lf-newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 25px;
  }
  .lf-input-group {
    position: relative;
  }
  .lf-input-group input {
    width: 100%;
    background: transparent;
    border: 1px solid var(--gh-border-gold);
    color: var(--gh-text-light);
    padding: 12px 40px 12px 15px;
    font-size: 13px;
    outline: none;
    border-radius: 4px;
  }
  .lf-input-icon {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--gh-golden);
  }
  .lf-submit-btn {
    background-color: var(--gh-golden);
    color: var(--gh-dark-bg);
    border: none;
    padding: 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    cursor: pointer;
    text-transform: uppercase;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    border-radius: 4px;
    transition: var(--gh-transition);
  }
  .lf-submit-btn:hover {
    background-color: #fff;
  }
  
  .lf-social-icons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }
  .lf-social-icons a {
    color: var(--gh-golden);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lf-social-icons svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* MIDDLE SECTION (Features) */
  .lf-mid-section {
    display: flex;
    justify-content: space-between;
    padding: 40px 0;
    border-bottom: 1px solid var(--gh-border-gold);
    position: relative;
    z-index: 2;
  }
  .lf-feature-block {
    flex: 1;
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding: 0 20px;
    border-right: 1px solid var(--gh-border-gold);
  }
  .lf-feature-block:first-child {
    padding-left: 0;
  }
  .lf-feature-block:last-child {
    border-right: none;
    padding-right: 0;
  }
  .lf-feature-icon {
    width: 32px;
    height: 32px;
    color: var(--gh-golden);
    flex-shrink: 0;
  }
  .lf-feature-icon svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.2;
  }
  .lf-feature-content h4 {
    margin: 0 0 5px;
    font-size: 12px;
    color: var(--gh-golden);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .lf-feature-content p {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
  }

  /* BOTTOM SECTION */
  .lf-bottom-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30px 0;
    position: relative;
    z-index: 2;
  }
  .lf-bottom-menu {
    display: flex;
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }
  .lf-bottom-menu li {
    display: flex;
    align-items: center;
  }
  .lf-bottom-menu li:not(:last-child)::after {
    content: '|';
    margin-left: 20px;
    color: var(--gh-border-gold);
  }
  .lf-bottom-menu a {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gh-golden);
  }

  /* MANDALA ICON */
  .lf-mandala-container {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: var(--gh-golden);
  }
  .lf-mandala-container svg {
    width: 36px;
    height: 36px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1;
  }

  /* Background Glow */
  .lf-bg-glow {
    position: absolute;
    left: -10%;
    bottom: -10%;
    width: 50%;
    height: 150%;
    background: radial-gradient(ellipse at bottom left, rgba(249, 226, 156, 0.15), transparent 70%);
    z-index: 1;
    pointer-events: none;
  }

  @media screen and (max-width: 1024px) {
    .lf-top-section {
      flex-wrap: wrap;
    }
    .lf-col-logo {
      flex: 1 1 100%;
      margin-bottom: 40px;
      padding-right: 0;
    }
    .lf-col-links-wrapper {
      border-left: none;
    }
    .lf-mid-section {
      flex-wrap: wrap;
      gap: 30px 0;
    }
    .lf-feature-block {
      flex: 1 1 50%;
      border-right: none;
      padding: 0 10px;
    }
    .lf-bottom-section {
      flex-direction: column;
      gap: 20px;
      padding-bottom: 70px;
    }
    .lf-bottom-menu {
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  @media screen and (max-width: 768px) {
    .lf-col-links-wrapper {
      flex-direction: column;
    }
    .lf-col-links {
      border-right: none;
      padding: 0;
      border-bottom: 1px solid var(--gh-border-gold);
    }
    .lf-col-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      margin-bottom: 0;
      padding: 20px 0;
    }
    .lf-accordion-icon {
      display: block;
    }
    .lf-col-title.is-open .lf-accordion-icon {
      transform: rotate(180deg);
    }
    .lf-accordion-content {
      display: none;
      padding-bottom: 20px;
    }
    .lf-col-title.is-open + .lf-accordion-content {
      display: block;
    }
    .lf-col-gh {
      flex: 1 1 100%;
      padding-left: 0;
      margin-top: 40px;
    }
    .lf-feature-block {
      flex: 1 1 100%;
    }
    .lf-bottom-menu li:not(:last-child)::after {
      display: none;
    }
    .lf-bottom-menu {
      gap: 15px;
    }
  }
</style>

<div class="lumina-footer-wrapper" data-section-id="{{ section.id }}">
  <div class="lf-bg-glow"></div>
  
  <div class="lf-top-section">
    <div class="lf-col-logo">
      <h2 class="lf-logo-title">{{ section.settings.logo_title | default: 'LUMINA' }}</h2>
      <div class="lf-logo-subtitle">{{ section.settings.logo_subtitle | default: 'EUROPA' }}</div>
      <div class="lf-logo-divider"></div>
      <div class="lf-tagline">
        {{ section.settings.tagline | default: 'Science.<br>Ritual.<br>Light.' }}
      </div>
      <div class="lf-copyright">
        {{ section.settings.copyright | default: '&copy; 2026 Lumina Europa.<br>All rights reserved.' }}
      </div>
    </div>
    
    <div class="lf-col-links-wrapper">
      <!-- COLUMN 1 -->
      <div class="lf-col-links">
        {% assign col1_heading = section.settings.col1_title | default: 'DISCOVER LUMINA' %}
        <h4 class="lf-col-title js-accordion-trigger">
          {% render 'processMenuTitle', itemName: col1_heading %}
          <svg class="lf-accordion-icon" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
        </h4>
        <div class="lf-accordion-content">
          <ul class="lf-menu-list">
            {% assign col1_menu = linklists[section.settings.col1_menu] %}
            {% if col1_menu != blank and col1_menu.links.size > 0 %}
              {% for link in col1_menu.links %}
                <li><a href="{{ link.url }}">{% render 'processMenuTitle', itemName: link.title %}</a></li>
              {% endfor %}
            {% else %}
              {% if section.settings.col1_link1_text != blank %}<li><a href="{{ section.settings.col1_link1_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col1_link1_text %}</a></li>{% endif %}
              {% if section.settings.col1_link2_text != blank %}<li><a href="{{ section.settings.col1_link2_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col1_link2_text %}</a></li>{% endif %}
              {% if section.settings.col1_link3_text != blank %}<li><a href="{{ section.settings.col1_link3_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col1_link3_text %}</a></li>{% endif %}
              {% if section.settings.col1_link4_text != blank %}<li><a href="{{ section.settings.col1_link4_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col1_link4_text %}</a></li>{% endif %}
              {% if section.settings.col1_link5_text != blank %}<li><a href="{{ section.settings.col1_link5_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col1_link5_text %}</a></li>{% endif %}
              {% if section.settings.col1_link6_text != blank %}<li><a href="{{ section.settings.col1_link6_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col1_link6_text %}</a></li>{% endif %}
            {% endif %}
          </ul>
        </div>
      </div>
      
      <!-- COLUMN 2 -->
      <div class="lf-col-links">
        {% assign col2_heading = section.settings.col2_title | default: 'COLLECTIONS & RITUALS' %}
        <h4 class="lf-col-title js-accordion-trigger">
          {% render 'processMenuTitle', itemName: col2_heading %}
          <svg class="lf-accordion-icon" viewBox="0 0 24 24"><path d="M6 9l6 6-6"/></svg>
        </h4>
        <div class="lf-accordion-content">
          {% if section.settings.col2_sub1_title != blank %}
            <div class="lf-col-subtitle">{% render 'processMenuTitle', itemName: section.settings.col2_sub1_title %}</div>
          {% endif %}
          <ul class="lf-menu-list">
            {% assign col2_sub1_menu = linklists[section.settings.col2_sub1_menu] %}
            {% if col2_sub1_menu != blank and col2_sub1_menu.links.size > 0 %}
              {% for link in col2_sub1_menu.links %}
                <li><a href="{{ link.url }}">{% render 'processMenuTitle', itemName: link.title %}</a></li>
              {% endfor %}
            {% else %}
              {% if section.settings.col2_sub1_link1_text != blank %}<li><a href="{{ section.settings.col2_sub1_link1_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col2_sub1_link1_text %}</a></li>{% endif %}
              {% if section.settings.col2_sub1_link2_text != blank %}<li><a href="{{ section.settings.col2_sub1_link2_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col2_sub1_link2_text %}</a></li>{% endif %}
              {% if section.settings.col2_sub1_link3_text != blank %}<li><a href="{{ section.settings.col2_sub1_link3_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col2_sub1_link3_text %}</a></li>{% endif %}
              {% if section.settings.col2_sub1_link4_text != blank %}<li><a href="{{ section.settings.col2_sub1_link4_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col2_sub1_link4_text %}</a></li>{% endif %}
            {% endif %}
          </ul>

          {% if section.settings.col2_sub2_title != blank %}
            <div class="lf-col-subtitle">{% render 'processMenuTitle', itemName: section.settings.col2_sub2_title %}</div>
          {% endif %}
          <ul class="lf-menu-list">
            {% assign col2_sub2_menu = linklists[section.settings.col2_sub2_menu] %}
            {% if col2_sub2_menu != blank and col2_sub2_menu.links.size > 0 %}
              {% for link in col2_sub2_menu.links %}
                <li><a href="{{ link.url }}">{% render 'processMenuTitle', itemName: link.title %}</a></li>
              {% endfor %}
            {% else %}
              {% if section.settings.col2_sub2_link1_text != blank %}<li><a href="{{ section.settings.col2_sub2_link1_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col2_sub2_link1_text %}</a></li>{% endif %}
              {% if section.settings.col2_sub2_link2_text != blank %}<li><a href="{{ section.settings.col2_sub2_link2_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col2_sub2_link2_text %}</a></li>{% endif %}
              {% if section.settings.col2_sub2_link3_text != blank %}<li><a href="{{ section.settings.col2_sub2_link3_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col2_sub2_link3_text %}</a></li>{% endif %}
            {% endif %}
          </ul>
        </div>
      </div>
      
      <!-- COLUMN 3 -->
      <div class="lf-col-links">
        {% assign col3_heading = section.settings.col3_title | default: 'HELP & CONCIERGE' %}
        <h4 class="lf-col-title js-accordion-trigger">
          {% render 'processMenuTitle', itemName: col3_heading %}
          <svg class="lf-accordion-icon" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
        </h4>
        <div class="lf-accordion-content">
          <ul class="lf-menu-list">
            {% assign col3_menu = linklists[section.settings.col3_menu] %}
            {% if col3_menu != blank and col3_menu.links.size > 0 %}
              {% for link in col3_menu.links %}
                <li><a href="{{ link.url }}">{% render 'processMenuTitle', itemName: link.title %}</a></li>
              {% endfor %}
            {% else %}
              {% if section.settings.col3_link1_text != blank %}<li><a href="{{ section.settings.col3_link1_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col3_link1_text %}</a></li>{% endif %}
              {% if section.settings.col3_link2_text != blank %}<li><a href="{{ section.settings.col3_link2_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col3_link2_text %}</a></li>{% endif %}
              {% if section.settings.col3_link3_text != blank %}<li><a href="{{ section.settings.col3_link3_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col3_link3_text %}</a></li>{% endif %}
              {% if section.settings.col3_link4_text != blank %}<li><a href="{{ section.settings.col3_link4_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col3_link4_text %}</a></li>{% endif %}
              {% if section.settings.col3_link5_text != blank %}<li><a href="{{ section.settings.col3_link5_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col3_link5_text %}</a></li>{% endif %}
              {% if section.settings.col3_link6_text != blank %}<li><a href="{{ section.settings.col3_link6_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col3_link6_text %}</a></li>{% endif %}
            {% endif %}
          </ul>
        </div>
      </div>
      
      <!-- COLUMN 4 -->
      <div class="lf-col-links">
        {% assign col4_heading = section.settings.col4_title | default: 'LEGAL' %}
        <h4 class="lf-col-title js-accordion-trigger">
          {% render 'processMenuTitle', itemName: col4_heading %}
          <svg class="lf-accordion-icon" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
        </h4>
        <div class="lf-accordion-content">
          <ul class="lf-menu-list">
            {% assign col4_menu = linklists[section.settings.col4_menu] %}
            {% if col4_menu != blank and col4_menu.links.size > 0 %}
              {% for link in col4_menu.links %}
                <li>
                  <a href="{{ link.url }}">{% render 'processMenuTitle', itemName: link.title %}</a>
                  {% if link.url contains 'anpc.ro' %}
                    <svg class="lf-icon-external" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
                  {% endif %}
                </li>
              {% endfor %}
            {% else %}
              {% if section.settings.col4_link1_text != blank %}<li><a href="{{ section.settings.col4_link1_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col4_link1_text %}</a></li>{% endif %}
              {% if section.settings.col4_link2_text != blank %}<li><a href="{{ section.settings.col4_link2_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col4_link2_text %}</a></li>{% endif %}
              {% if section.settings.col4_link3_text != blank %}<li><a href="{{ section.settings.col4_link3_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col4_link3_text %}</a></li>{% endif %}
              {% if section.settings.col4_link4_text != blank %}<li><a href="{{ section.settings.col4_link4_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col4_link4_text %}</a></li>{% endif %}
              {% if section.settings.col4_link5_text != blank %}<li><a href="{{ section.settings.col4_link5_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.col4_link5_text %}</a></li>{% endif %}
              {% if section.settings.col4_link6_text != blank %}
                <li>
                  <a href="{{ section.settings.col4_link6_url | default: 'https://anpc.ro/' }}" {% if section.settings.col4_link6_url contains 'anpc.ro' or section.settings.col4_link6_url == blank %}target="_blank"{% endif %}>{% render 'processMenuTitle', itemName: section.settings.col4_link6_text %}</a>
                  <svg class="lf-icon-external" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
                </li>
              {% endif %}
            {% endif %}
