  <!-- MIDDLE SECTION (Features) -->
  <div class="lf-mid-section">
    <div class="lf-feature-block">
      <div class="lf-feature-icon">
        <svg viewBox="0 0 24 24"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="16.5" cy="18.5" r="2.5"/></svg>
      </div>
      <div class="lf-feature-content">
        <h4>{{ section.settings.feat1_title | default: 'COMPLIMENTARY SHIPPING' }}</h4>
        <p>{{ section.settings.feat1_text | default: 'On orders over €150' }}</p>
      </div>
    </div>
    <div class="lf-feature-block">
      <div class="lf-feature-icon">
        <svg viewBox="0 0 24 24"><path d="M22 12c0 5.52-4.48 10-10 10S2 17.52 2 12 6.48 2 12 2c2.76 0 5.26 1.12 7.07 2.93"/><path d="M14 5h5v5"/></svg>
      </div>
      <div class="lf-feature-content">
        <h4>{{ section.settings.feat2_title | default: '30-DAY RETURNS' }}</h4>
        <p>{{ section.settings.feat2_text | default: 'Effortless, insured,<br>and worry-free.' }}</p>
      </div>
    </div>
    <div class="lf-feature-block">
      <div class="lf-feature-icon">
        <svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><path d="M1 10h22"/></svg>
      </div>
      <div class="lf-feature-content">
        <h4>{{ section.settings.feat3_title | default: 'SECURE PAYMENTS' }}</h4>
        <p>{{ section.settings.feat3_text | default: 'Visa &bull; Mastercard &bull; Apple Pay<br>Google Pay &bull; PayPal &bull; Klarna' }}</p>
      </div>
    </div>
    <div class="lf-feature-block">
      <div class="lf-feature-icon">
        <svg viewBox="0 0 24 24"><path d="M3 18v-6a9 9 0 0118 0v6"/><path d="M21 19a2 2 0 01-2 2h-1v-4h3v2zM3 19a2 2 0 002 2h1v-4H3v2z"/></svg>
      </div>
      <div class="lf-feature-content">
        <h4>{{ section.settings.feat4_title | default: 'CONCIERGE & SUPPORT' }}</h4>
        <p><a href="mailto:{{ section.settings.feat4_email | default: 'office@luminaeuropa.com' }}">{{ section.settings.feat4_email | default: 'office@luminaeuropa.com' }}</a></p>
      </div>
    </div>
    <div class="lf-feature-block">
      <div class="lf-feature-icon">
        <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div class="lf-feature-content">
        <h4>{{ section.settings.feat5_title | default: 'CRAFTED WITH CARE IN EUROPE' }}</h4>
        <p>{{ section.settings.feat5_text | default: 'Quality, transparency<br>and responsibility.' }}</p>
      </div>
    </div>
  </div>
  
  <!-- BOTTOM SECTION -->
  <div class="lf-bottom-section">
    <ul class="lf-bottom-menu">
      {% assign bottom_menu = linklists[section.settings.bottom_menu] %}
      {% if bottom_menu != blank and bottom_menu.links.size > 0 %}
        {% for link in bottom_menu.links %}
          <li><a href="{{ link.url }}">{% render 'processMenuTitle', itemName: link.title %}</a></li>
        {% endfor %}
      {% else %}
        {% if section.settings.bm_link1_text != blank %}<li><a href="{{ section.settings.bm_link1_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.bm_link1_text %}</a></li>{% endif %}
        {% if section.settings.bm_link2_text != blank %}<li><a href="{{ section.settings.bm_link2_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.bm_link2_text %}</a></li>{% endif %}
        {% if section.settings.bm_link3_text != blank %}<li><a href="{{ section.settings.bm_link3_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.bm_link3_text %}</a></li>{% endif %}
        {% if section.settings.bm_link4_text != blank %}<li><a href="{{ section.settings.bm_link4_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.bm_link4_text %}</a></li>{% endif %}
        {% if section.settings.bm_link5_text != blank %}<li><a href="{{ section.settings.bm_link5_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.bm_link5_text %}</a></li>{% endif %}
        {% if section.settings.bm_link6_text != blank %}<li><a href="{{ section.settings.bm_link6_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.bm_link6_text %}</a></li>{% endif %}
        {% if section.settings.bm_link7_text != blank %}<li><a href="{{ section.settings.bm_link7_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.bm_link7_text %}</a></li>{% endif %}
        {% if section.settings.bm_link8_text != blank %}<li><a href="{{ section.settings.bm_link8_url | default: '#' }}">{% render 'processMenuTitle', itemName: section.settings.bm_link8_text %}</a></li>{% endif %}
      {% endif %}
    </ul>
  </div>

  <div class="lf-mandala-container">
    <svg viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="10"/>
      <circle cx="50" cy="30" r="20"/>
      <circle cx="50" cy="70" r="20"/>
      <circle cx="30" cy="50" r="20"/>
      <circle cx="70" cy="50" r="20"/>
      <circle cx="36" cy="36" r="20"/>
      <circle cx="64" cy="64" r="20"/>
      <circle cx="64" cy="36" r="20"/>
      <circle cx="36" cy="64" r="20"/>
    </svg>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const triggers = document.querySelectorAll('.js-accordion-trigger');
    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        if (window.innerWidth <= 768) {
          trigger.classList.toggle('is-open');
        }
      });
    });
  });
</script>

