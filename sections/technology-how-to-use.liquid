<style>
  #technology-how-to-use {
    padding: 80px 0;
    background-color: var(--color-bg, #000);
  }
  .tech-htu-heading {
    text-align: center;
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 50px;
    color: var(--g-color-heading, #fff);
  }
  .tech-htu-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    margin-bottom: 40px;
  }
  .tech-htu-frame {
    text-align: center;
  }
  .tech-htu-image-wrapper {
    width: 100%;
    padding-bottom: 100%;
    position: relative;
    overflow: hidden;
    margin-bottom: 20px;
  }
  .tech-htu-image-wrapper img {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  .tech-htu-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--g-color-heading, #fff);
  }
  .tech-htu-text {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-body-text, #FAF6F0);
  }
  .tech-htu-footer {
    text-align: center;
  }
  .tech-htu-btn {
    display: inline-block;
    padding: 12px 30px;
    background-color: transparent;
    border: 1px solid #fff;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
  }
  .tech-htu-btn:hover {
    background-color: #fff;
    color: #000;
    transform: translateY(-2px);
  }
  
  @media (min-width: 576px) {
    .tech-htu-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 992px) {
    .tech-htu-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<div id="technology-how-to-use" data-section-id="{{ section.id }}">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="tech-htu-heading" data-aos="fade-up" data-aos-duration="700">{{ section.settings.heading }}</h2>
    {% endif %}
    
    <div class="tech-htu-grid">
      {% for block in section.blocks %}
        <div class="tech-htu-frame" data-aos="fade-up" data-aos-duration="700" data-aos-delay="{{ forloop.index | times: 100 }}" {{ block.shopify_attributes }}>
          <div class="tech-htu-image-wrapper">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {% else %}
              {% case forloop.index %}
                {% when 1 %}
                  <img src="{{ '1._unfold.png' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                {% when 2 %}
                  <img src="{{ '2._activate.png' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                {% when 3 %}
                  <img src="{{ '3apply.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                {% when 4 %}
                  <img src="{{ '5._remove.png' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                {% else %}
                  <img src="{{ '6._finish.png' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {% endcase %}
            {% endif %}
          </div>
          <h3 class="tech-htu-title">{{ block.settings.title }}</h3>
          <div class="tech-htu-text">{{ block.settings.text }}</div>
        </div>
      {% endfor %}
    </div>
    
    {% if section.settings.enable_button and section.settings.button_label != blank %}
      <div class="tech-htu-footer" data-aos="fade-up" data-aos-duration="700">
        <a href="{{ section.settings.button_link }}" class="tech-htu-btn">{{ section.settings.button_label }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Technology How to Use",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Ritual Activated in Moments"
    },
    {
      "type": "checkbox",
      "id": "enable_button",
      "label": "Enable Button",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "View Full Application Guide"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "frame",
      "name": "Step Frame",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image Frame"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Prepare"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Caption",
          "default": "Begin with clean, dry skin."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Technology How to Use",
      "blocks": [
        {
          "type": "frame",
          "settings": {
            "title": "Prepare",
            "text": "Begin with clean, dry skin."
          }
        },
        {
          "type": "frame",
          "settings": {
            "title": "Position",
            "text": "Remove the dry mask carefully and place it over the intended area."
          }
        },
        {
          "type": "frame",
          "settings": {
            "title": "Activate",
            "text": "Apply the recommended amount of water or mist until the nanofibre structure begins to dissolve."
          }
        },
        {
          "type": "frame",
          "settings": {
            "title": "Complete",
            "text": "Allow the formula to settle into the skin and follow the instructions provided with your chosen mask."
          }
        }
      ]
    }
  ]
}
{% endschema %}
