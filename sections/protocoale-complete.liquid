{% style %}
.cr-section {
  position: relative;
  background-color: var(--cr-bg-color);
  padding-top: var(--cr-pt-desktop);
  padding-bottom: var(--cr-pb-desktop);
  margin-top: var(--cr-margin-top);
  margin-bottom: var(--cr-margin-bottom);
  overflow: hidden;
}

.cr-bg-image {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}

.cr-bg-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.cr-container {
  position: relative;
  z-index: 1;
  max-width: var(--cr-max-width);
  margin: 0 auto;
  padding: 0 20px;
}

/* Header */
.cr-header {
  text-align: center;
  margin: 0 auto;
}

.cr-top-icon {
  display: flex;
  justify-content: center;
  margin-bottom: 16px;
}

.cr-heading {
  color: var(--cr-heading-color);
  font-size: var(--cr-heading-size-desktop);
  font-weight: var(--cr-heading-weight);
  line-height: 1.15;
  margin: 0 0 16px 0;
}

.cr-subheading {
  color: var(--cr-sub-color);
  font-size: var(--cr-sub-size-desktop);
  font-weight: var(--cr-sub-weight);
  line-height: 1.6;
  max-width: 640px;
  margin: 0 auto;
}

.cr-subheading p {
  margin: 0;
}

/* Divider */
.cr-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  margin: 48px 0 40px 0;
}

.cr-divider-line {
  flex: 1 1 auto;
  max-width: 320px;
  height: 1px;
  background-color: var(--cr-divider-line-color);
  opacity: 0.6;
}

.cr-divider-text {
  flex: 0 0 auto;
  color: var(--cr-divider-text-color);
  font-size: var(--cr-divider-size-desktop);
  font-weight: var(--cr-divider-weight);
  white-space: nowrap;
}

/* Slider & Arrows Base */
.cr-arrow {
  display: none;
}

/* Grid */
.cr-grid {
  display: grid;
  grid-template-columns: repeat(var(--cr-columns-desktop), 1fr);
  gap: var(--cr-grid-gap-desktop);
}

/* Card */
.cr-card {
  background-color: var(--cr-card-bg);
  border: 1px solid var(--cr-card-border-color);
  border-radius: var(--cr-card-radius);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.25s ease, border-color 0.25s ease;
}

.cr-card:hover {
  transform: translateY(-4px);
}

.cr-card-image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
}

.cr-card-image,
.cr-card-image-placeholder svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.cr-card-icon-badge {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cr-card-content {
  padding: var(--cr-card-padding-desktop);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.cr-card-title {
  color: var(--cr-title-color);
  font-size: var(--cr-title-size-desktop);
  font-weight: var(--cr-title-weight);
  margin: 0;
}

.cr-card-rating {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: var(--cr-rating-size);
}

.cr-stars {
  display: inline-flex;
  gap: 2px;
}

.cr-star-full {
  color: var(--cr-star-color);
}

.cr-star-empty {
  color: var(--cr-star-empty-color);
}

.cr-rating-count {
  color: var(--cr-rating-count-color);
}

.cr-card-price {
  color: var(--cr-price-color);
  font-size: var(--cr-price-size-desktop);
  font-weight: var(--cr-price-weight);
}

.cr-card-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 6px;
  padding: 12px 26px;
  color: var(--cr-btn-text-color);
  background-color: var(--cr-btn-bg-color);
  border: 1px solid var(--cr-btn-border-color);
  border-radius: var(--cr-btn-radius);
  font-size: var(--cr-btn-size-desktop);
  font-weight: var(--cr-btn-weight);
  text-decoration: none;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  transition: color 0.25s ease, background-color 0.25s ease, border-color 0.25s ease;
}

.cr-card-btn:hover {
  color: var(--cr-btn-hover-text-color);
  background-color: var(--cr-btn-hover-bg-color);
  border-color: var(--cr-btn-hover-border-color);
}

.cr-btn-icon {
  flex-shrink: 0;
}

.cr-card-empty {
  color: var(--cr-rating-count-color);
  font-size: 14px;
  padding: 20px 0;
}

/* Tablet: up to 1024px */
@media screen and (max-width: 1024px) {
  .cr-section {
    padding-top: var(--cr-pt-tablet);
    padding-bottom: var(--cr-pb-tablet);
  }

  .cr-heading {
    font-size: var(--cr-heading-size-tablet);
  }

  .cr-divider-text {
    font-size: var(--cr-divider-size-tablet);
  }

  .cr-grid {
    grid-template-columns: repeat(var(--cr-columns-tablet), 1fr);
    gap: var(--cr-grid-gap-desktop);
  }
}

/* Mobile: up to 749px */
@media screen and (max-width: 749px) {
  .cr-section {
    padding-top: var(--cr-pt-mobile);
    padding-bottom: var(--cr-pb-mobile);
  }

  .cr-container {
    padding: 0 16px;
  }

  .cr-heading {
    font-size: var(--cr-heading-size-mobile);
  }

  .cr-subheading {
    font-size: var(--cr-sub-size-mobile);
  }

  .cr-divider {
    margin: 32px 0 28px 0;
    gap: 12px;
  }

  .cr-divider-text {
    font-size: var(--cr-divider-size-mobile);
  }

  .cr-slider-outer {
    display: flex;
    align-items: center;
    position: relative;
  }

  .cr-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 32px;
    height: 32px;
    background-color: var(--cr-card-bg);
    border: 1px solid var(--cr-card-border-color);
    border-radius: 50%;
    color: var(--cr-title-color);
    cursor: pointer;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
  }
  
  .cr-arrow svg {
    width: 16px;
    height: 16px;
  }

  .cr-arrow-prev {
    left: -16px;
  }

  .cr-arrow-next {
    right: -16px;
  }
  
  .cr-arrow[disabled] {
    opacity: 0.3;
    pointer-events: none;
  }

  .cr-grid {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: var(--cr-grid-gap-mobile);
    padding-bottom: 10px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    flex: 1;
  }
  
  .cr-grid::-webkit-scrollbar {
    display: none;
  }

  .cr-card {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .cr-card-content {
    padding: var(--cr-card-padding-mobile);
  }

  .cr-card-title {
    font-size: var(--cr-title-size-mobile);
  }

  .cr-card-price {
    font-size: var(--cr-price-size-mobile);
  }

  .cr-card-btn {
    font-size: var(--cr-btn-size-mobile);
    padding: 10px 20px;
  }
}
{% endstyle %}

<div class="cr-section-{{ section.id }}"
  style="
    --cr-max-width: {{ section.settings.max_width }}px;
    --cr-bg-color: {{ section.settings.bg_color }};
    --cr-pt-desktop: {{ section.settings.padding_top_desktop }}px;
    --cr-pb-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --cr-pt-tablet: {{ section.settings.padding_top_tablet }}px;
    --cr-pb-tablet: {{ section.settings.padding_bottom_tablet }}px;
    --cr-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --cr-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --cr-margin-top: {{ section.settings.margin_top }}px;
    --cr-margin-bottom: {{ section.settings.margin_bottom }}px;

    --cr-heading-color: {{ section.settings.heading_color }};
    --cr-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --cr-heading-size-tablet: {{ section.settings.heading_size_tablet }}px;
    --cr-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --cr-heading-weight: {{ section.settings.heading_weight }};

    --cr-sub-color: {{ section.settings.subheading_color }};
    --cr-sub-size-desktop: {{ section.settings.subheading_size_desktop }}px;
    --cr-sub-size-mobile: {{ section.settings.subheading_size_mobile }}px;
    --cr-sub-weight: {{ section.settings.subheading_weight }};

    --cr-divider-line-color: {{ section.settings.divider_line_color }};
    --cr-divider-text-color: {{ section.settings.divider_text_color }};
    --cr-divider-size-desktop: {{ section.settings.divider_size_desktop }}px;
    --cr-divider-size-mobile: {{ section.settings.divider_size_mobile }}px;
    --cr-divider-weight: {{ section.settings.divider_weight }};

    --cr-columns-desktop: {{ section.settings.columns_desktop }};
    --cr-columns-tablet: {{ section.settings.columns_tablet }};
    --cr-columns-mobile: {{ section.settings.columns_mobile }};
    --cr-grid-gap-desktop: {{ section.settings.grid_gap_desktop }}px;
    --cr-grid-gap-mobile: {{ section.settings.grid_gap_mobile }}px;

    --cr-card-bg: {{ section.settings.card_bg_color }};
    --cr-card-border-color: {{ section.settings.card_border_color }};
    --cr-card-radius: {{ section.settings.card_radius }}px;
    --cr-card-padding-desktop: {{ section.settings.card_padding_desktop }}px;
    --cr-card-padding-mobile: {{ section.settings.card_padding_mobile }}px;

    --cr-title-color: {{ section.settings.title_color }};
    --cr-title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --cr-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --cr-title-weight: {{ section.settings.title_weight }};

    --cr-star-color: {{ section.settings.star_color }};
    --cr-star-empty-color: {{ section.settings.star_empty_color }};
    --cr-rating-count-color: {{ section.settings.rating_count_color }};
    --cr-rating-size: {{ section.settings.rating_size }}px;

    --cr-price-color: {{ section.settings.price_color }};
    --cr-price-size-desktop: {{ section.settings.price_size_desktop }}px;
    --cr-price-size-mobile: {{ section.settings.price_size_mobile }}px;
    --cr-price-weight: {{ section.settings.price_weight }};

    --cr-btn-text-color: {{ section.settings.button_text_color }};
    --cr-btn-border-color: {{ section.settings.button_border_color }};
    --cr-btn-bg-color: {{ section.settings.button_bg_color }};
    --cr-btn-hover-text-color: {{ section.settings.button_hover_text_color }};
    --cr-btn-hover-bg-color: {{ section.settings.button_hover_bg_color }};
    --cr-btn-hover-border-color: {{ section.settings.button_hover_border_color }};
    --cr-btn-size-desktop: {{ section.settings.button_size_desktop }}px;
    --cr-btn-size-mobile: {{ section.settings.button_size_mobile }}px;
    --cr-btn-weight: {{ section.settings.button_weight }};
    --cr-btn-radius: {{ section.settings.button_radius }}px;
  "
  class="cr-section"
>
  {% if section.settings.bg_image %}
    <div class="cr-bg-image">
      {{ section.settings.bg_image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: '' }}
    </div>
  {% endif %}

  <div class="cr-container">

    <div class="cr-header">
      {% if section.settings.top_icon != blank %}
        <div class="cr-top-icon">{{ section.settings.top_icon }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="cr-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="cr-subheading">{{ section.settings.subheading }}</div>
      {% endif %}
    </div>

    {% if section.settings.divider_text != blank %}
      <div class="cr-divider">
        <span class="cr-divider-line"></span>
        <span class="cr-divider-text">{{ section.settings.divider_text }}</span>
        <span class="cr-divider-line"></span>
      </div>
    {% endif %}

    {%- comment -%}
      Per-product override: if the CURRENT product has this metafield filled in
      (list of product references), those products are shown instead of the
      section's static blocks below. This lets every product page show its own
      "Protocoale & complete" picks without duplicating templates or re-editing
      the section per product.

      Metafield to create (Settings > Custom data > Products):
        Namespace and key: custom.protocoale_complete
        Type: List of products
    {%- endcomment -%}
    {% assign cr_meta_products = product.metafields.custom.protocoale_complete.value %}
    {% assign cr_meta_titles = product.metafields.custom.protocoale_titles.value %}

    <div class="cr-slider-outer">
      <button type="button" class="cr-arrow cr-arrow-prev" aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="cr-grid" data-cr-track>
      {% if cr_meta_products and cr_meta_products.size > 0 %}

        {% for cr_product in cr_meta_products limit: 8 %}
          {% assign cr_custom_title = cr_meta_titles[forloop.index0] %}
          {% assign cr_display_title = cr_custom_title | default: cr_product.title %}
          <div class="cr-card">

            <div class="cr-card-image-wrap">
              {% if cr_product.featured_image %}
                {{ cr_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: cr_display_title, class: 'cr-card-image' }}
              {% else %}
                <img src="{{ 'ChatGPT_Image_Aug_10_2026_03_22_12_PM.png' | asset_url }}" loading="lazy" alt="{{ cr_display_title }}" class="cr-card-image">
              {% endif %}
            </div>

            <div class="cr-card-content">
              {% if cr_display_title != blank %}
                <h3 class="cr-card-title">{{ cr_display_title }}</h3>
              {% endif %}

              {% assign cr_rating = cr_product.metafields.reviews.rating.value %}
              {% assign cr_rating_count = cr_product.metafields.reviews.rating_count.value %}
              {% if cr_rating %}
                <div class="cr-card-rating" aria-label="Rating {{ cr_rating }} din 5">
                  <span class="cr-stars">
                    {% assign full_stars = cr_rating | floor %}
                    {% for i in (1..5) %}
                      {% if i <= full_stars %}
                        <svg class="cr-star cr-star-full" viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9l-5.3 2.8 1-5.9L1.5 7.7l5.9-.8L10 1.5z"/></svg>
                      {% else %}
                        <svg class="cr-star cr-star-empty" viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9l-5.3 2.8 1-5.9L1.5 7.7l5.9-.8L10 1.5z"/></svg>
                      {% endif %}
                    {% endfor %}
                  </span>
                  {% if cr_rating_count %}
                    <span class="cr-rating-count">({{ cr_rating_count }})</span>
                  {% endif %}
                </div>
              {% endif %}

              <div class="cr-card-price">{{ cr_product.price | money }}</div>

              {% if section.settings.button_text != blank %}
                <a href="{{ cr_product.url }}" class="cr-card-btn">
                  <span>{{ section.settings.button_text }}</span>
                  {% if section.settings.show_button_icon %}
                    <svg class="cr-btn-icon" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {% endif %}
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}

      {% else %}

        {% for block in section.blocks %}
          {% case block.type %}

          {% when 'product_card' %}
            {% assign cr_product = block.settings.product %}
            <div class="cr-card" {{ block.shopify_attributes }}>

              <div class="cr-card-image-wrap">
                {% if block.settings.icon_badge != blank %}
                  <span class="cr-card-icon-badge">{{ block.settings.icon_badge }}</span>
                {% endif %}

                {% if cr_product and cr_product.featured_image %}
                  {{ cr_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: cr_product.title, class: 'cr-card-image' }}
                {% else %}
                  <img src="{{ 'ChatGPT_Image_Aug_10_2026_03_22_12_PM.png' | asset_url }}" loading="lazy" alt="Lumina Product" class="cr-card-image">
                {% endif %}
              </div>

              <div class="cr-card-content">
                {% assign cr_title = block.settings.custom_title | default: cr_product.title %}
                {% if cr_title != blank %}
                  <h3 class="cr-card-title">{{ cr_title }}</h3>
                {% endif %}

                {% if cr_product %}
                  {% assign cr_rating = cr_product.metafields.reviews.rating.value %}
                  {% assign cr_rating_count = cr_product.metafields.reviews.rating_count.value %}
                  {% if cr_rating %}
                    <div class="cr-card-rating" aria-label="Rating {{ cr_rating }} din 5">
                      <span class="cr-stars">
                        {% assign full_stars = cr_rating | floor %}
                        {% for i in (1..5) %}
                          {% if i <= full_stars %}
                            <svg class="cr-star cr-star-full" viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9l-5.3 2.8 1-5.9L1.5 7.7l5.9-.8L10 1.5z"/></svg>
                          {% else %}
                            <svg class="cr-star cr-star-empty" viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9l-5.3 2.8 1-5.9L1.5 7.7l5.9-.8L10 1.5z"/></svg>
                          {% endif %}
                        {% endfor %}
                      </span>
                      {% if cr_rating_count %}
                        <span class="cr-rating-count">({{ cr_rating_count }})</span>
                      {% endif %}
                    </div>
                  {% endif %}

                  <div class="cr-card-price">{{ cr_product.price | money }}</div>

                  {% if section.settings.button_text != blank %}
                    <a href="{{ cr_product.url }}" class="cr-card-btn">
                      <span>{{ section.settings.button_text }}</span>
                      {% if section.settings.show_button_icon %}
                        <svg class="cr-btn-icon" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {% endif %}
                    </a>
                  {% endif %}
                {% else %}
                  <p class="cr-card-empty">Select a product for this card.</p>
                {% endif %}
              </div>
            </div>

          {% endcase %}
        {% endfor %}

      {% elsif collections.all.products.size > 0 %}
        {% for cr_product in collections.all.products limit: 4 %}
          <div class="cr-card">
            <div class="cr-card-image-wrap">
              {% if cr_product.featured_image %}
                {{ cr_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: cr_product.title, class: 'cr-card-image' }}
              {% else %}
                <img src="{{ 'WhatsApp_Image_2026-07-09_at_14.32.17.jpg' | asset_url }}" class="cr-card-image" alt="{{ cr_product.title }}" loading="lazy">
              {% endif %}
            </div>
            <div class="cr-card-content">
              <h3 class="cr-card-title">{{ cr_product.title }}</h3>
              <div class="cr-card-price">{{ cr_product.price | money }}</div>
              <a href="{{ cr_product.url }}" class="cr-card-btn">
                <span>{{ section.settings.button_text | default: 'Discover' }}</span>
                {% if section.settings.show_button_icon %}
                  <svg class="cr-btn-icon" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% endif %}
              </a>
            </div>
          </div>
        {% endfor %}

      {% endif %}
      </div>

      <button type="button" class="cr-arrow cr-arrow-next" aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

  </div>
</div>

<script>
  (function () {
    function initCrSliders() {
      document.querySelectorAll('.cr-slider-outer').forEach(function (outer) {
        if (outer.dataset.crInit) return;
        outer.dataset.crInit = 'true';

        var track = outer.querySelector('[data-cr-track]');
        var prevBtn = outer.querySelector('.cr-arrow-prev');
        var nextBtn = outer.querySelector('.cr-arrow-next');

        if (!track || !prevBtn || !nextBtn) return;

        function updateArrowState() {
          var maxScroll = track.scrollWidth - track.clientWidth - 2;
          prevBtn.disabled = track.scrollLeft <= 2;
          nextBtn.disabled = track.scrollLeft >= maxScroll;
        }

        prevBtn.addEventListener('click', function () {
          var step = track.clientWidth;
          track.scrollBy({ left: -step, behavior: 'smooth' });
        });

        nextBtn.addEventListener('click', function () {
          var step = track.clientWidth;
          track.scrollBy({ left: step, behavior: 'smooth' });
        });

        track.addEventListener('scroll', updateArrowState, { passive: true });
        window.addEventListener('resize', updateArrowState);
        
        setTimeout(updateArrowState, 100);
      });
    }

    document.addEventListener('DOMContentLoaded', initCrSliders);
    if (document.readyState !== 'loading') initCrSliders();
    document.addEventListener('shopify:section:load', initCrSliders);
  })();
</script>

{% schema %}
{
  "name": "Protocoale & complete",
  "tag": "section",
  "class": "section-protocoale-complete",
  "settings": [
    {
      "type": "paragraph",
      "content": "-"
    },
    {
      "type": "header",
      "content": "Layout general"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 900,
      "max": 1600,
      "step": 10,
      "unit": "px",
      "label": "Max width (section)",
      "default": 1200
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Culoare fundal",
      "default": "#0a0a0a"
    },
    {
      "type": "image_picker",
