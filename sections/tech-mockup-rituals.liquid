{% render 'golden-hour-vars' %}
<style>
  #shopify-section-{{ section.id }} .tm-rit-wrap {
    padding: 100px 24px;
    background-color: #000;
  }
  .tm-rit-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-wrap: nowrap;
    gap: 40px;
    align-items: center;
  }
  .tm-rit-left {
    flex: 0 0 300px;
  }
  .tm-rit-subtitle {
    font-size: 11px;
    letter-spacing: 0.15em;
    color: var(--gh-golden);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .tm-rit-title {
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    color: var(--gh-golden);
    font-family: serif;
    font-weight: 300;
    line-height: 1.1;
    margin-bottom: 24px;
  }
  .tm-rit-link {
    font-size: 11px;
    color: var(--gh-golden);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .tm-rit-link svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .tm-rit-right {
    flex: 1;
    min-width: 0;
  }
  .tm-rit-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }
  @media screen and (max-width: 1200px) {
    .tm-rit-grid { grid-template-columns: repeat(3, 1fr); row-gap: 32px; }
  }
  @media screen and (max-width: 900px) {
    .tm-rit-container { flex-direction: column; }
    .tm-rit-left { flex: none; margin-bottom: 40px; }
  }
  .tm-rit-carousel-wrap {
    position: relative;
  }
  .tm-rit-arrow-mobile {
    display: none;
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(0,0,0,0.6);
    border: 1px solid var(--gh-golden);
    color: var(--gh-golden);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .tm-rit-arrow-mobile svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .tm-rit-arrow-prev { left: 4px; }
  .tm-rit-arrow-next { right: 4px; }

  @media screen and (max-width: 768px) {
    .tm-rit-arrow-mobile {
      display: flex;
    }
    .tm-rit-grid {
      display: flex;
      overflow-x: auto;
      gap: 16px;
      padding-bottom: 20px;
      scrollbar-width: none;
      -ms-overflow-style: none;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
    }
    .tm-rit-grid::-webkit-scrollbar {
      display: none;
    }
    .tm-rit-card {
      flex: 0 0 100%;
      scroll-snap-align: center;
    }
  }
  .tm-rit-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .tm-rit-image {
    width: 100%;
    position: relative;
    padding-bottom: 150%; /* 2:3 aspect ratio */
    background: #111;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .tm-rit-image img {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.7;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .tm-rit-card:hover .tm-rit-image img {
    opacity: 1;
    transform: scale(1.03);
  }
  .tm-rit-card-title {
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gh-golden);
    margin-bottom: 8px;
    text-align: left;
  }
  .tm-rit-card-desc {
    font-size: 11px;
    line-height: 1.5;
    color: var(--gh-text-muted);
    text-align: left;
  }
</style>

<div id="{{ section.id | split: '__' | last }}" class="tm-rit-wrap">
  <div class="tm-rit-container">
    <div class="tm-rit-left">
      <div class="tm-rit-subtitle">{{ section.settings.subtitle }}</div>
      <h2 class="tm-rit-title">{{ section.settings.title | newline_to_br }}</h2>
    </div>

    <div class="tm-rit-right">
      <div class="tm-rit-carousel-wrap">
        <button class="tm-rit-arrow-mobile tm-rit-arrow-prev" aria-label="Previous">
          <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="tm-rit-grid">
          {% for block in section.blocks %}
          <div class="tm-rit-card" {{ block.shopify_attributes }}>
            <div class="tm-rit-image">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" loading="lazy">
              {% else %}
                {% assign img_idx = forloop.index | plus: 6 %}
                {% assign rit_fallback = 'img-' | append: img_idx | append: '.png' %}
                <img src="{{ rit_fallback | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
              {% endif %}
            </div>
            <div class="tm-rit-card-title">{{ block.settings.title }}</div>
            <div class="tm-rit-card-desc">{{ block.settings.text }}</div>
          </div>
        {% endfor %}
        </div>
        <button class="tm-rit-arrow-mobile tm-rit-arrow-next" aria-label="Next">
          <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('#shopify-section-{{ section.id }}');
    if (!section) return;
    
    const scrollContainer = section.querySelector('.tm-rit-grid');
    const prevBtn = section.querySelector('.tm-rit-arrow-prev');
    const nextBtn = section.querySelector('.tm-rit-arrow-next');
    
    if (scrollContainer && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        scrollContainer.scrollBy({ left: -scrollContainer.offsetWidth, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        scrollContainer.scrollBy({ left: scrollContainer.offsetWidth, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Mockup - Rituals",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "DISCOVER YOUR RITUAL"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Every moment. A ritual."
    }
  ],
  "blocks": [
    {
      "type": "ritual",
      "name": "Ritual Card",
      "limit": 5,
      "settings": [
