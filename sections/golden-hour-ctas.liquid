{% render 'golden-hour-vars' %}
{%- style -%}
  #shopify-section-{{ section.id }} .gh-ctas-wrap {
    position: relative;
    background-color: var(--gh-dark-bg);
    {% if section.settings.section_bg_image != blank %}
    background-image: url('{{ section.settings.section_bg_image | image_url: width: 2400 }}');
    background-size: cover;
    background-position: center;
    {% endif %}
    color: var(--gh-text-light);
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    width: 100%;
    margin: 0 auto;
    height: {{ section.settings.min_height_desktop }}px;
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .gh-ctas-wrap {
      padding: 0 16px;
      height: {{ section.settings.min_height_mobile }}px;
    }
  }

  .gh-ctas-video-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }
  
  .gh-ctas-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.05); /* Avoid anti-aliasing edges */
  }

  .gh-ctas-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 2;
  }

  .gh-ctas-content {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .gh-ctas-heading {
    font-size: {{ section.settings.heading_size_desktop }}px;
    color: var(--gh-golden);
    margin-bottom: 48px;
    font-weight: 300;
    font-family: serif;
    line-height: 1.2;
    max-width: 800px;
  }
  @media screen and (max-width: 1024px) {
    .gh-ctas-heading {
      font-size: calc({{ section.settings.heading_size_desktop }}px * 0.85);
    }
  }
  @media screen and (max-width: 768px) {
    .gh-ctas-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
      margin-bottom: 32px;
    }
  }
  
  .gh-ctas-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  @media screen and (max-width: 768px) {
    .gh-ctas-buttons {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
      gap: 16px;
    }
  }
  
  .gh-btn-primary, .gh-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 36px;
    font-size: {{ section.settings.btn_size_desktop }}px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: var(--gh-transition);
    width: 100%;
    max-width: 360px;
  }
  @media screen and (max-width: 768px) {
    .gh-btn-primary, .gh-btn-secondary {
      font-size: {{ section.settings.btn_size_mobile }}px;
      padding: 16px 28px;
    }
  }
  
  .gh-btn-primary {
    background-color: var(--gh-golden);
    color: var(--gh-dark-bg);
    font-weight: 500;
    border: 1px solid var(--gh-golden);
  }
  .gh-btn-primary:hover {
    background-color: transparent;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(249, 226, 156, 0.25);
  }
  
  .gh-btn-secondary {
    background-color: transparent;
    color: var(--gh-golden);
    border: 1px solid var(--gh-border-gold);
    font-weight: 400;
  }
  .gh-btn-secondary:hover {
    background-color: rgba(249, 226, 156, 0.1);
    border-color: var(--gh-golden);
    transform: translateY(-2px);
  }
{%- endstyle -%}

<div class="gh-ctas-wrap" id="{{ section.id | split: '__' | last }}" data-section-id="{{ section.id }}">
  <div class="gh-ctas-video-wrap">
    {%- if section.settings.video != blank and section.settings.video.sources != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'gh-ctas-video' }}
    {%- elsif section.settings.video != blank -%}
      <video class="gh-ctas-video" autoplay loop muted playsinline poster="{{ 'Screenshot_2026-03-31_at_14.31.38.png' | asset_url }}">
        <source src="{% if section.settings.video contains 'http' %}{{ section.settings.video }}{% else %}{{ section.settings.video | file_url }}{% endif %}" type="video/mp4">
        <source src="{{ 'video 6 starting the ritual.mp4' | file_url }}" type="video/mp4">
        <source src="{{ 'video_6_starting_the_ritual.mp4' | file_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.heading }}" class="gh-ctas-video">
    {%- else -%}
      <video class="gh-ctas-video" autoplay loop muted playsinline poster="{{ 'Screenshot_2026-03-31_at_14.31.38.png' | asset_url }}">
        <source src="{{ 'video 6 starting the ritual.mp4' | file_url }}" type="video/mp4">
        <source src="{{ 'video_6_starting_the_ritual.mp4' | file_url }}" type="video/mp4">
        <source src="{{ 'The Golden Hour HERO.mp4' | file_url }}" type="video/mp4">
      </video>
    {%- endif -%}
  </div>

  <div class="gh-ctas-overlay"></div>

  <div class="gh-ctas-content">
    {%- if section.settings.heading != blank -%}
      <h2 class="gh-ctas-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="gh-ctas-buttons">
      <a href="{{ section.settings.primary_url | default: '#' }}" class="gh-btn-primary">
        {{ section.settings.primary_label }}
      </a>
      <a href="{{ section.settings.secondary_url | default: '/' }}" class="gh-btn-secondary">
        {{ section.settings.secondary_label }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Golden Hour - CTAs",
  "settings": [
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum Content Width (px)",
      "min": 800,
      "max": 2000,
      "step": 50,
      "default": 1450
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background Video"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Video Overlay Opacity (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A place where taking care of yourself becomes art."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary Button Label",
      "default": "DEVINO MEMBRU LUMINA GOLDEN HOUR"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary Button Label",
      "default": "BACK TO THE STORE"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Desktop Settings"
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum Height (Desktop px)",
      "min": 200,
      "max": 1000,
      "step": 10,
      "default": 600
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading Size (Desktop px)",
      "min": 24,
      "max": 56,
      "step": 2,
      "default": 42
    },
    {
      "type": "range",
      "id": "btn_size_desktop",
      "label": "Button Text Size (Desktop px)",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top Padding (Desktop px)",
      "min": 40,
      "max": 180,
      "step": 10,
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom Padding (Desktop px)",
      "min": 40,
      "max": 180,
      "step": 10,
      "default": 120
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum Height (Mobile px)",
      "min": 200,
      "max": 800,
      "step": 10,
      "default": 400
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size (Mobile px)",
      "min": 18,
      "max": 36,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "btn_size_mobile",
      "label": "Button Text Size (Mobile px)",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top Padding (Mobile px)",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom Padding (Mobile px)",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Golden Hour - CTAs"
    }
  ]
}
{% endschema %}
