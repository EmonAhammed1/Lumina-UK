<style>
  #technology-nanofibres {
    padding: 80px 0;
    background-color: var(--color-bg, #000);
  }
  .tech-nano-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .tech-nano-image-col, .tech-nano-text-col {
    width: 100%;
    padding: 20px;
  }
  .tech-nano-image-wrapper {
    position: relative;
    padding-bottom: 66.875%;
    overflow: hidden;
  }
  .tech-nano-image-wrapper img {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  .tech-nano-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 20px;
    color: var(--g-color-heading, #fff);
  }
  .tech-nano-body {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 30px;
    color: var(--color-body-text, #FAF6F0);
  }
  .tech-nano-highlight {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--g-main, #B8963E);
    border-left: 2px solid var(--g-main, #B8963E);
    padding-left: 15px;
  }
  @media (min-width: 768px) {
    .tech-nano-image-col, .tech-nano-text-col {
      width: 50%;
    }
    .tech-nano-row.image-right {
      flex-direction: row-reverse;
    }
    .tech-nano-text-col {
      padding: 40px 60px;
    }
  }
</style>

<div id="technology-nanofibres" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="tech-nano-row {% if section.settings.image_position == 'right' %}image-right{% endif %}">
      <div class="tech-nano-image-col" data-aos="fade-up" data-aos-duration="700">
        <div class="tech-nano-image-wrapper">
          {% if section.settings.image != blank %}
            <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
          {% else %}
            <img src="{{ 'nano-fiber-stracture.webp' | asset_url }}" alt="Nanofibers Technology" loading="lazy">
          {% endif %}
        </div>
      </div>
      <div class="tech-nano-text-col" data-aos="fade-up" data-aos-duration="700" data-aos-delay="200">
        {% if section.settings.heading != blank %}
          <h2 class="tech-nano-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="tech-nano-body">{{ section.settings.text }}</div>
        {% endif %}
        {% if section.settings.highlight_text != blank %}
          <div class="tech-nano-highlight">{{ section.settings.highlight_text }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Technology Nanofiberss",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop Image Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Macro Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Structure of Extraordinary Fineness"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>Nanofiberss are extremely fine fibres arranged into a light, delicate matrix. In Lumina masks, this microscopic structure carries the formula in a dry format rather than suspending it in a conventional liquid-soaked sheet. When activated with the recommended amount of water or facial mist, the structure begins to dissolve, releasing the formula across the skin.</p>"
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlight Statement",
      "default": "Dry until activated. Precise by design."
    }
  ],
  "presets": [
    {
      "name": "Technology Nanofiberss"
    }
  ]
}
{% endschema %}
