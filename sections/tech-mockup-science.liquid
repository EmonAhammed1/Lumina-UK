{% render 'golden-hour-vars' %}
<style>
  #shopify-section-{{ section.id }} .tm-science-wrap {
    padding: 100px 24px;
    background-color: #050505;
    color: var(--gh-text-light);
  }
  .tm-science-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-wrap: nowrap;
    gap: 40px;
    align-items: center;
  }
  .tm-science-left {
    flex: 0 0 320px;
  }
  .tm-science-subtitle {
    font-size: 11px;
    letter-spacing: 0.15em;
    color: var(--gh-golden);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .tm-science-title {
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    color: var(--gh-golden);
    font-family: serif;
    font-weight: 300;
    line-height: 1.1;
    margin-bottom: 24px;
  }
  .tm-science-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--gh-text-muted);
    margin-bottom: 32px;
  }
  .tm-science-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--gh-golden);
    text-transform: uppercase;
    text-decoration: none;
  }
  .tm-science-link svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .tm-science-center {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 20px;
  }
  .tm-science-stats {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }
  .tm-science-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    flex: 1;
  }
  .tm-science-stat:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -10px;
    top: 10%;
    height: 80%;
    width: 1px;
    background-color: rgba(249, 226, 156, 0.2);
  }
  .tm-science-stat-value {
    font-size: 40px;
    font-weight: 300;
    color: var(--gh-golden);
    font-family: serif;
    margin-bottom: 8px;
    line-height: 1;
  }
  .tm-science-stat-value.text-value {
    font-size: 14px;
    font-family: sans-serif;
    color: #fff;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .tm-science-stat-label {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gh-text-muted);
    max-width: 150px;
  }
  .tm-science-caption {
    font-size: 11px;
    color: var(--gh-text-muted);
    text-align: center;
    font-style: italic;
  }
  .tm-science-right {
    flex: 0 0 320px;
    position: relative;
  }
  .tm-science-image {
    width: 100%;
    position: relative;
    padding-bottom: 75%; /* 4:3 aspect ratio */
    background: #111;
    overflow: hidden;
  }
  .tm-science-image img,
  .tm-science-image video {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.8;
  }
  @media screen and (max-width: 1200px) {
    .tm-science-container {
      flex-direction: column;
    }
    .tm-science-left, .tm-science-center, .tm-science-right {
      flex: none;
      width: 100%;
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }
    .tm-science-stats {
      margin: 40px 0 20px;
      flex-wrap: wrap;
    }
    .tm-science-stat:not(:last-child)::after {
      display: none;
    }
  }
</style>

<div id="{{ section.id | split: '__' | last }}" class="tm-science-wrap">
  <div class="tm-science-container">
    <div class="tm-science-left">
      <div class="tm-science-subtitle">{{ section.settings.subtitle }}</div>
      <h2 class="tm-science-title">{{ section.settings.title | newline_to_br }}</h2>
      <div class="tm-science-desc">{{ section.settings.text }}</div>
      
      {% if section.settings.btn_label != blank %}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="tm-science-link">
          {{ section.settings.btn_label }}
          <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {% endif %}
    </div>
    
    <div class="tm-science-center">
      <div class="tm-science-stats">
        {% for block in section.blocks %}
          <div class="tm-science-stat" {{ block.shopify_attributes }}>
            {% if block.settings.value == 'Logo' or block.settings.value == 'NANOPHARMA' %}
              <div class="tm-science-stat-label" style="margin-bottom: 4px; text-transform: none;">Dezvoltat de</div>
              <div class="tm-science-stat-value text-value">NANOPHARMA</div>
              <div class="tm-science-stat-label">SWITZERLAND</div>
            {% else %}
              <div class="tm-science-stat-value">{{ block.settings.value }}</div>
              <div class="tm-science-stat-label">{{ block.settings.label }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
      {% if section.settings.caption != blank %}
        <div class="tm-science-caption">{{ section.settings.caption }}</div>
      {% endif %}
    </div>
    
    <div class="tm-science-right">
      <div class="tm-science-image">
        {% if section.settings.video != blank %}
          {% if section.settings.video.sources != blank %}
            {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
          {% else %}
            <video autoplay loop muted playsinline preload="metadata">
              <source src="{% if section.settings.video contains 'http' %}{{ section.settings.video }}{% else %}{{ section.settings.video | file_url }}{% endif %}" type="video/mp4">
              <source src="{{ 'kling_20260710_VIDEO_Cinematic__2868_0.mp4' | file_url }}" type="video/mp4">
              <source src="{{ '6_experience_technology_player.mp4' | file_url }}" type="video/mp4">
            </video>
          {% endif %}
        {% elsif section.settings.video_url != blank %}
          <video autoplay loop muted playsinline preload="metadata">
            <source src="{% if section.settings.video_url contains 'http' %}{{ section.settings.video_url }}{% else %}{{ section.settings.video_url | file_url }}{% endif %}" type="video/mp4">
            <source src="{{ 'kling_20260710_VIDEO_Cinematic__2868_0.mp4' | file_url }}" type="video/mp4">
          </video>
        {% elsif section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="Scientist" loading="lazy">
        {% else %}
          <video autoplay loop muted playsinline preload="metadata" poster="{{ 'Johana-Kulhankova-1.jpg' | asset_url }}">
            <source src="{{ 'kling_20260710_VIDEO_Cinematic__2868_0.mp4' | file_url }}" type="video/mp4">
            <source src="{{ '6_experience_technology_player.mp4' | file_url }}" type="video/mp4">
            <source src="{{ 'e3f98bcbeb284f078f969195472fb265.mp4' | file_url }}" type="video/mp4">
            <source src="https://cdn.shopify.com/videos/c/o/v/e3f98bcbeb284f078f969195472fb265.mp4" type="video/mp4">
          </video>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mockup - Science",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "SCIENTIFIC FOUNDATION"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Backed by science.\nDriven by results."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Developed by NanoPharma, our nanofibre technology is supported by rigorous research, clinical trials and ongoing innovation."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "EXPLORE THE RESEARCH"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Right Video (Overrides Image)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Image (Scientist Fallback)"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image Caption",
      "default": "Clinical evaluation of the nanofibre mask performed by an independent institute."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value (e.g. 10+)",
          "default": "10+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "YEARS OF RESEARCH"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mockup - Science",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "Logo",
            "label": "Developed by NANOPHARMA SWITZERLAND"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "10+",
            "label": "YEARS OF RESEARCH"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "25+",
            "label": "CLINICAL STUDIES"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "1000+",
            "label": "PARTICIPANTS WORLDWIDE"
          }
        }
      ]
    }
  ]
}
{% endschema %}
