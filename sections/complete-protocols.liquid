<div class="cp-section cp-section-{{ section.id }}{% if section.settings.break_out_full_width %} cp-break-out{% endif %}">
  <div class="cp-container" style="max-width: {{ section.settings.max_width }}px;">

    <div class="cp-heading-wrap">
      {% if section.settings.heading != blank %}
        <div class="cp-heading-line-row">
          <span class="cp-line cp-line-left"></span>
          <h2 class="cp-heading">{{ section.settings.heading }}</h2>
          <span class="cp-line cp-line-right"></span>
        </div>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="cp-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="cp-slider-outer">
      {% if section.settings.enable_arrows %}
        <button type="button" class="cp-arrow cp-arrow-prev" aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {% endif %}

      <div class="cp-track" data-cp-track>
        {% for block in section.blocks %}
          {% if block.type == 'card' %}
            <div class="cp-card" {{ block.shopify_attributes }}>
              <div class="cp-card-media">
                <a href="{{ block.settings.card_link | default: '#' }}" class="cp-card-image-link" aria-label="{{ block.settings.title | escape }}">
                  {% if block.settings.image != blank %}
                    <img
                      class="cp-card-image"
                      src="{{ block.settings.image | image_url: width: 900 }}"
                      srcset="{{ block.settings.image | image_url: width: 450 }} 450w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                      sizes="(max-width: 749px) 90vw, 320px"
                      alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                      loading="lazy"
                    >
                  {% else %}
                    <div class="cp-card-image cp-card-image--placeholder">{{ 'image' | placeholder_svg_tag: 'cp-placeholder-svg' }}</div>
                  {% endif %}
                </a>
              </div>

              <div class="cp-card-content">
                {% if block.settings.show_icon and block.settings.icon != blank %}
                  <div class="cp-icon-wrap">
                    <img class="cp-icon" src="{{ block.settings.icon | image_url: width: 100 }}" alt="" loading="lazy" width="40" height="40">
                  </div>
                {% endif %}

                {% if block.settings.title != blank %}
                  <h3 class="cp-card-title">{{ block.settings.title }}</h3>
                {% endif %}

                {% if block.settings.description != blank %}
                  <p class="cp-card-desc">{{ block.settings.description }}</p>
                {% endif %}

                {% if block.settings.price != blank %}
                  <div class="cp-card-price">{{ block.settings.price }}</div>
                {% endif %}

                {% if block.settings.button_text != blank %}
                  <a href="{{ block.settings.card_link | default: '#' }}" class="cp-card-btn">
                    <span>{{ block.settings.button_text }}</span>
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="cp-btn-arrow">
                      <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.enable_arrows %}
        <button type="button" class="cp-arrow cp-arrow-next" aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {% endif %}
    </div>

    {% if section.settings.enable_arrows %}
      <div class="cp-dots" data-cp-dots></div>
    {% endif %}

    {% if section.settings.bottom_text != blank %}
      <div class="cp-bottom-banner">
        <p>{{ section.settings.bottom_text }}</p>
      </div>
    {% endif %}

  </div>
</div>

<style>
  .cp-section-{{ section.id }} {
    --cp-bg: {{ section.settings.bg_color }};
    --cp-max-width: {{ section.settings.max_width }}px;

    --cp-pad-top-d: {{ section.settings.padding_top_desktop }}px;
    --cp-pad-bottom-d: {{ section.settings.padding_bottom_desktop }}px;
    --cp-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --cp-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;

    --cp-margin-top-d: {{ section.settings.margin_top_desktop }}px;
    --cp-margin-bottom-d: {{ section.settings.margin_bottom_desktop }}px;
    --cp-margin-top-m: {{ section.settings.margin_top_mobile }}px;
    --cp-margin-bottom-m: {{ section.settings.margin_bottom_mobile }}px;

    --cp-heading-color: {{ section.settings.heading_color }};
    --cp-heading-size-d: {{ section.settings.heading_size_desktop }}px;
    --cp-heading-size-m: {{ section.settings.heading_size_mobile }}px;
    --cp-heading-weight: {{ section.settings.heading_weight }};
    --cp-line-color: {{ section.settings.line_color }};

    --cp-sub-color: {{ section.settings.subheading_color }};
    --cp-sub-size-d: {{ section.settings.subheading_size_desktop }}px;
    --cp-sub-size-m: {{ section.settings.subheading_size_mobile }}px;
    --cp-sub-weight: {{ section.settings.subheading_weight }};

    --cp-columns-d: {{ section.settings.columns_desktop }};
    --cp-columns-m: {{ section.settings.columns_mobile }};
    --cp-gap-d: {{ section.settings.gap_desktop }}px;
    --cp-gap-m: {{ section.settings.gap_mobile }}px;

    --cp-card-bg: {{ section.settings.card_bg_color }};
    --cp-card-border: {{ section.settings.card_border_color }};
    --cp-card-radius: {{ section.settings.card_radius }}px;
    --cp-card-padding: {{ section.settings.card_padding }}px;
    --cp-image-radius: {{ section.settings.image_radius }}px;
    --cp-image-ratio: {{ section.settings.image_aspect_ratio }};
    --cp-image-fit: {{ section.settings.image_fit }};
    --cp-image-padding: {{ section.settings.image_padding }}px;
    --cp-image-bg: {{ section.settings.image_bg_color }};

    --cp-icon-size: {{ section.settings.icon_size }}px;

    --cp-title-color: {{ section.settings.title_color }};
    --cp-title-size-d: {{ section.settings.title_size_desktop }}px;
    --cp-title-size-m: {{ section.settings.title_size_mobile }}px;
    --cp-title-weight: {{ section.settings.title_weight }};

    --cp-desc-color: {{ section.settings.desc_color }};
    --cp-desc-size-d: {{ section.settings.desc_size_desktop }}px;
    --cp-desc-size-m: {{ section.settings.desc_size_mobile }}px;
    --cp-desc-weight: {{ section.settings.desc_weight }};

    --cp-price-color: {{ section.settings.price_color }};
    --cp-price-size-d: {{ section.settings.price_size_desktop }}px;
    --cp-price-size-m: {{ section.settings.price_size_mobile }}px;
    --cp-price-weight: {{ section.settings.price_weight }};

    --cp-btn-bg: {{ section.settings.button_bg }};
    --cp-btn-text: {{ section.settings.button_text_color }};
    --cp-btn-border: {{ section.settings.button_border_color }};
    --cp-btn-bg-hover: {{ section.settings.button_bg_hover }};
    --cp-btn-text-hover: {{ section.settings.button_text_hover }};
    --cp-btn-size-d: {{ section.settings.button_size_desktop }}px;
    --cp-btn-size-m: {{ section.settings.button_size_mobile }}px;
    --cp-btn-weight: {{ section.settings.button_weight }};
    --cp-btn-radius: {{ section.settings.button_radius }}px;

    --cp-arrow-bg: {{ section.settings.arrow_bg_color }};
    --cp-arrow-color: {{ section.settings.arrow_icon_color }};
    --cp-arrow-size: {{ section.settings.arrow_size }}px;

    --cp-banner-border: {{ section.settings.banner_border_color }};
    --cp-banner-color: {{ section.settings.banner_text_color }};
    --cp-banner-size-d: {{ section.settings.banner_size_desktop }}px;
    --cp-banner-size-m: {{ section.settings.banner_size_mobile }}px;
    --cp-banner-weight: {{ section.settings.banner_weight }};

    padding-top: var(--cp-pad-top-d);
    padding-bottom: var(--cp-pad-bottom-d);
    margin-top: var(--cp-margin-top-d);
    margin-bottom: var(--cp-margin-bottom-d);
    background: var(--cp-bg);
  }

  @media screen and (max-width: 749px) {
    .cp-section-{{ section.id }} {
      padding-top: var(--cp-pad-top-m);
      padding-bottom: var(--cp-pad-bottom-m);
      margin-top: var(--cp-margin-top-m);
      margin-bottom: var(--cp-margin-bottom-m);
    }
  }

  /* ---------- Base styles (shared, scoped to this section) ---------- */
  .cp-section-{{ section.id }} .cp-section-inner,
  .cp-section-{{ section.id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .cp-section-{{ section.id }} .cp-container {
    max-width: var(--cp-max-width, 1200px) !important;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Use this when your theme wraps sections in its own max-width container
     and the "Max width" setting above seems to have no visible effect. */
  .cp-section-{{ section.id }}.cp-break-out {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }

  /* Heading */
  .cp-section-{{ section.id }} .cp-heading-wrap {
    text-align: center;
    margin-bottom: 32px;
  }

  .cp-section-{{ section.id }} .cp-heading-line-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 10px;
  }

  .cp-section-{{ section.id }} .cp-line {
    flex: 1 1 60px;
    max-width: 120px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cp-line-color, #8a6a2f));
  }
  .cp-section-{{ section.id }} .cp-line-right {
    background: linear-gradient(90deg, var(--cp-line-color, #8a6a2f), transparent);
  }

  .cp-section-{{ section.id }} .cp-heading {
    color: var(--cp-heading-color);
    font-size: var(--cp-heading-size-m);
    font-weight: var(--cp-heading-weight);
    margin: 0;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  .cp-section-{{ section.id }} .cp-subheading {
    color: var(--cp-sub-color);
    font-size: var(--cp-sub-size-m);
    font-weight: var(--cp-sub-weight);
    margin: 0 auto;
    max-width: 640px;
    line-height: 1.5;
  }

  /* Slider */
  .cp-section-{{ section.id }} .cp-slider-outer {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cp-section-{{ section.id }} .cp-track {
    display: flex;
    gap: var(--cp-gap-m);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    flex: 1 1 auto;
    padding-bottom: 6px;
  }

  .cp-section-{{ section.id }} .cp-track::-webkit-scrollbar {
    height: 4px;
  }
  .cp-section-{{ section.id }} .cp-track::-webkit-scrollbar-thumb {
    background: var(--cp-line-color, #8a6a2f);
    border-radius: 4px;
  }

  .cp-section-{{ section.id }} .cp-card {
    scroll-snap-align: start;
    flex: 0 0 calc((100% - (var(--cp-columns-m) - 1) * var(--cp-gap-m)) / var(--cp-columns-m));
    background: var(--cp-card-bg);
    border: 1px solid var(--cp-card-border);
    border-radius: var(--cp-card-radius);
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    text-align: center;
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .cp-section-{{ section.id }} .cp-card:hover {
    border-color: var(--cp-heading-color, #d4af6a);
  }

  .cp-section-{{ section.id }} .cp-card-media {
    padding: var(--cp-image-padding);
  }

  .cp-section-{{ section.id }} .cp-card-image-link {
    display: block;
    width: 100%;
    aspect-ratio: var(--cp-image-ratio);
    overflow: hidden;
    border-radius: var(--cp-image-radius);
    background: var(--cp-image-bg);
  }

  .cp-section-{{ section.id }} .cp-card-image,
  .cp-section-{{ section.id }} .cp-card-image--placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: var(--cp-image-fit);
    object-position: center;
  }

  .cp-section-{{ section.id }} .cp-card-image--placeholder svg {
    width: 100%;
    height: 100%;
  }

  .cp-section-{{ section.id }} .cp-card-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 var(--cp-card-padding) var(--cp-card-padding);
    flex: 1;
  }

  .cp-section-{{ section.id }} .cp-icon-wrap {
    width: var(--cp-icon-size);
    height: var(--cp-icon-size);
    border-radius: 50%;
    border: 1px solid var(--cp-line-color, #8a6a2f);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 16px 0 10px;
  }

  .cp-section-{{ section.id }} .cp-icon {
    width: 60%;
    height: 60%;
    object-fit: contain;
  }

  .cp-section-{{ section.id }} .cp-card-title {
    color: var(--cp-title-color);
    font-size: var(--cp-title-size-m);
    font-weight: var(--cp-title-weight);
    margin: 4px 0 8px;
  }

  .cp-section-{{ section.id }} .cp-card-desc {
    color: var(--cp-desc-color);
    font-size: var(--cp-desc-size-m);
    font-weight: var(--cp-desc-weight);
    line-height: 1.5;
    margin: 0 0 14px;
  }

  .cp-section-{{ section.id }} .cp-card-price {
    color: var(--cp-price-color);
    font-size: var(--cp-price-size-m);
    font-weight: var(--cp-price-weight);
    margin-bottom: 16px;
  }

  .cp-section-{{ section.id }} .cp-card-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    border: 1px solid var(--cp-btn-border);
    background: var(--cp-btn-bg);
    color: var(--cp-btn-text);
    font-size: var(--cp-btn-size-m);
    font-weight: var(--cp-btn-weight);
    letter-spacing: 0.5px;
    text-decoration: none;
    border-radius: var(--cp-btn-radius);
    width: 100%;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .cp-section-{{ section.id }} .cp-card-btn:hover {
    background: var(--cp-btn-bg-hover);
    color: var(--cp-btn-text-hover);
  }

  .cp-section-{{ section.id }} .cp-btn-arrow {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  /* Arrows */
  .cp-section-{{ section.id }} .cp-arrow {
    flex: 0 0 auto;
    width: var(--cp-arrow-size);
    height: var(--cp-arrow-size);
    border-radius: 50%;
    border: 1px solid var(--cp-arrow-color);
    background: var(--cp-arrow-bg);
    color: var(--cp-arrow-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
    z-index: 2;
  }

  .cp-section-{{ section.id }} .cp-arrow svg {
    width: 45%;
    height: 45%;
  }

  .cp-section-{{ section.id }} .cp-arrow:hover {
    background: var(--cp-arrow-color);
    color: var(--cp-arrow-bg);
  }

  .cp-section-{{ section.id }} .cp-arrow[disabled] {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .cp-section-{{ section.id }} .cp-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 16px;
  }

  .cp-section-{{ section.id }} .cp-dots .cp-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cp-line-color, #8a6a2f);
    opacity: 0.4;
    cursor: pointer;
    border: none;
    padding: 0;
  }

  .cp-section-{{ section.id }} .cp-dots .cp-dot.is-active {
    opacity: 1;
  }

  /* Bottom banner */
  .cp-section-{{ section.id }} .cp-bottom-banner {
    margin-top: 40px;
    border: 1px solid var(--cp-banner-border);
    border-radius: 4px;
    padding: 16px 20px;
    text-align: center;
  }

  .cp-section-{{ section.id }} .cp-bottom-banner p {
    margin: 0;
    color: var(--cp-banner-color);
    font-size: var(--cp-banner-size-m);
    font-weight: var(--cp-banner-weight);
    letter-spacing: 1px;
  }

  /* ---------- Desktop overrides (>=750px) ---------- */
  @media screen and (min-width: 750px) {
    .cp-section-{{ section.id }} .cp-heading {
      font-size: var(--cp-heading-size-d);
    }
    .cp-section-{{ section.id }} .cp-subheading {
      font-size: var(--cp-sub-size-d);
    }
    .cp-section-{{ section.id }} .cp-track {
      gap: var(--cp-gap-d);
    }
    .cp-section-{{ section.id }} .cp-card {
      flex: 0 0 calc((100% - (var(--cp-columns-d) - 1) * var(--cp-gap-d)) / var(--cp-columns-d));
    }
    .cp-section-{{ section.id }} .cp-card-title {
      font-size: var(--cp-title-size-d);
    }
    .cp-section-{{ section.id }} .cp-card-desc {
      font-size: var(--cp-desc-size-d);
    }
    .cp-section-{{ section.id }} .cp-card-price {
      font-size: var(--cp-price-size-d);
    }
    .cp-section-{{ section.id }} .cp-card-btn {
      font-size: var(--cp-btn-size-d);
    }
    .cp-section-{{ section.id }} .cp-bottom-banner p {
      font-size: var(--cp-banner-size-d);
    }
  }

  @media screen and (max-width: 749px) {
    .cp-section-{{ section.id }} .cp-heading {
      white-space: normal;
    }
    .cp-section-{{ section.id }} .cp-card-btn {
      width: auto;
      padding: 12px 22px;
    }
  }
</style>

<script>
  (function () {
    function initCpSliders(root) {
      var scope = root || document;
      scope.querySelectorAll('.cp-slider-outer').forEach(function (outer) {
        if (outer.dataset.cpInit) return;
        outer.dataset.cpInit = 'true';

        var track = outer.querySelector('[data-cp-track]');
        if (!track) return;

        var prevBtn = outer.querySelector('.cp-arrow-prev');
        var nextBtn = outer.querySelector('.cp-arrow-next');
        var container = outer.closest('.cp-container');
        var dotsWrap = container ? container.querySelector('[data-cp-dots]') : null;

        function getStep() {
          var card = track.querySelector('.cp-card');
          if (!card) return 300;
          var style = getComputedStyle(track);
          var gap = parseFloat(style.gap || style.columnGap || 0) || 0;
          return card.getBoundingClientRect().width + gap;
        }

        function updateArrowState() {
          if (!prevBtn || !nextBtn) return;
          var maxScroll = track.scrollWidth - track.clientWidth - 2;
          prevBtn.disabled = track.scrollLeft <= 2;
          nextBtn.disabled = track.scrollLeft >= maxScroll;
        }

        function buildDots() {
          if (!dotsWrap) return;
          dotsWrap.innerHTML = '';
          var cards = track.querySelectorAll('.cp-card');
          cards.forEach(function (_, i) {
            var dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'cp-dot' + (i === 0 ? ' is-active' : '');
            dot.setAttribute('aria-label', 'Go to card ' + (i + 1));
            dot.addEventListener('click', function () {
              track.scrollTo({ left: i * getStep(), behavior: 'smooth' });
            });
            dotsWrap.appendChild(dot);
          });
        }

        function updateDots() {
          if (!dotsWrap) return;
          var dots = dotsWrap.querySelectorAll('.cp-dot');
          var index = Math.round(track.scrollLeft / getStep());
          dots.forEach(function (dot, i) {
            dot.classList.toggle('is-active', i === index);
          });
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', function () {
            track.scrollBy({ left: -getStep(), behavior: 'smooth' });
          });
        }
        if (nextBtn) {
          nextBtn.addEventListener('click', function () {
            track.scrollBy({ left: getStep(), behavior: 'smooth' });
          });
        }

        track.addEventListener('scroll', function () {
          updateArrowState();
          updateDots();
        }, { passive: true });

        window.addEventListener('resize', function () {
          updateArrowState();
          updateDots();
        });

        buildDots();
        updateArrowState();
        updateDots();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initCpSliders(document);
      });
    } else {
      initCpSliders(document);
    }

    document.addEventListener('shopify:section:load', function (e) {
      initCpSliders(e.target);
    });
  })();
</script>

{% schema %}
{
  "name": "Complete Protocols",
  "tag": "section",
  "class": "cp-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Protocoale complete"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Complete rituals, visible results. Choose the protocol that suits you."
    },
    {
      "type": "textarea",
      "id": "bottom_text",
      "label": "Bottom banner text",
      "default": "DISCOVER LIGHT. LIVE THE RITUAL. BECOME THE BEST VERSION OF YOU."
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
      "min": 900,
      "max": 2400,
      "step": 20,
      "default": 1200
    },
    {
      "type": "checkbox",
      "id": "break_out_full_width",
      "label": "Break out of theme's width limit",
      "info": "Turn this ON if increasing Max width above doesn't seem to make the section wider — your theme may be wrapping sections in its own container.",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
