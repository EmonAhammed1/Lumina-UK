<!-- sections/lumina-world-journal-grid.liquid -->
<style>
  .lumina-journal-section {
    background-color: #040404;
    color: #ffffff;
    position: relative;
    padding: 70px 0;
    width: 100%;
    border-top: 1px solid rgba(197, 160, 89, 0.25);
    border-bottom: 1px solid rgba(197, 160, 89, 0.25);
    overflow: hidden;
    scroll-margin-top: 90px;
  }

  .lwj-container {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 45px;
    box-sizing: border-box;
  }

  /* Header Bar */
  .lwj-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }

  .lwj-header-label {
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #c5a059;
    font-weight: 500;
    opacity: 0.9;
  }

  .lwj-explore-link {
    color: #c5a059;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
  }

  .lwj-explore-link:hover {
    color: #d8b26a;
    transform: translateX(4px);
  }

  /* Grid Layout: Main Container */
  .lwj-grid-frame {
    display: grid;
    grid-template-columns: 1.1fr 1.9fr;
    gap: 16px;
    width: 100%;
  }

  /* Featured Left Article Card */
  .lwj-featured-card {
    position: relative;
    background-color: #080808;
    border: 1px solid rgba(197, 160, 89, 0.3);
    border-radius: 3px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 50px 40px;
    min-height: 480px;
    box-sizing: border-box;
    transition: border-color 0.3s ease;
    text-decoration: none;
  }

  .lwj-featured-card:hover {
    border-color: rgba(197, 160, 89, 0.65);
  }

  .lwj-card-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.6s ease;
  }

  .lwj-featured-card:hover .lwj-card-bg,
  .lwj-mini-card:hover .lwj-card-bg {
    transform: scale(1.05);
  }

  .lwj-card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(4, 4, 4, 0.3) 0%, rgba(4, 4, 4, 0.88) 100%);
    z-index: 2;
  }

  .lwj-featured-content {
    position: relative;
    z-index: 3;
  }

  .lwj-category {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #c5a059;
    font-weight: 600;
    margin-bottom: 14px;
    display: block;
  }

  .lwj-featured-title {
    font-family: var(--g-font-2), "Cormorant Garamond", "Times New Roman", serif;
    font-size: 36px;
    line-height: 1.18;
    font-weight: 400;
    color: #ffffff;
    margin: 0 0 16px 0;
    letter-spacing: 0.01em;
  }

  .lwj-excerpt {
    font-size: 13.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 28px;
    font-weight: 300;
    max-width: 420px;
  }

  .lwj-read-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #c5a059;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .lwj-read-link svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    transition: transform 0.3s ease;
  }

  .lwj-featured-card:hover .lwj-read-link svg,
  .lwj-mini-card:hover .lwj-read-link svg {
    transform: translateX(4px);
  }

  /* Right 6 Cards Grid (3 Columns x 2 Rows) */
  .lwj-right-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 16px;
  }

  .lwj-mini-card {
    position: relative;
    background-color: #080808;
    border: 1px solid rgba(197, 160, 89, 0.25);
    border-radius: 3px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px 20px;
    min-height: 228px;
    box-sizing: border-box;
    text-decoration: none;
    transition: border-color 0.3s ease;
  }

  .lwj-mini-card:hover {
    border-color: rgba(197, 160, 89, 0.6);
  }

  .lwj-mini-card-top {
    position: relative;
    z-index: 3;
  }

  .lwj-mini-card-bottom {
    position: relative;
    z-index: 3;
    margin-top: 20px;
  }

  .lwj-mini-title {
    font-family: var(--g-font-2), "Cormorant Garamond", "Times New Roman", serif;
    font-size: 20px;
    line-height: 1.25;
    font-weight: 400;
    color: #ffffff;
    margin: 0;
  }

  /* Bottom Submit Story Button */
  .lwj-bottom-action {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 36px;
    width: 100%;
  }

  .lwj-submit-journal-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background-color: transparent;
    color: #c5a059;
    border: 1px solid rgba(197, 160, 89, 0.4);
    border-radius: 2px;
    padding: 14px 34px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    position: relative;
    overflow: hidden;
    outline: none;
    text-decoration: none;
    font-family: inherit;
  }

  .lwj-submit-journal-trigger::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(197, 160, 89, 0.2), transparent);
    transition: left 0.6s ease;
  }

  .lwj-submit-journal-trigger:hover {
    background-color: rgba(197, 160, 89, 0.12);
    border-color: #c5a059;
    color: #ffffff;
    box-shadow: 0 0 25px rgba(197, 160, 89, 0.3);
    transform: translateY(-2px);
  }

  .lwj-submit-journal-trigger:hover::before {
    left: 100%;
  }

  .lwj-submit-journal-trigger svg {
    transition: transform 0.3s ease;
  }

  .lwj-submit-journal-trigger:hover svg {
    transform: translateX(4px);
  }

  /* Modal Popup Styles */
  .lwj-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .lwj-modal-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .lwj-modal-container {
    position: relative;
    background-color: #090909;
    border: 1px solid rgba(197, 160, 89, 0.35);
    border-radius: 4px;
    width: 100%;
    max-width: 620px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 44px 38px;
    box-sizing: border-box;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.95), 0 0 40px rgba(197, 160, 89, 0.08);
    transform: scale(0.94) translateY(10px);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lwj-modal-overlay.is-active .lwj-modal-container {
    transform: scale(1) translateY(0);
  }

  .lwj-modal-container::-webkit-scrollbar {
    width: 6px;
  }
  .lwj-modal-container::-webkit-scrollbar-track {
    background: #060606;
  }
  .lwj-modal-container::-webkit-scrollbar-thumb {
    background: rgba(197, 160, 89, 0.3);
    border-radius: 3px;
  }

  .lwj-modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: transparent;
    border: 1px solid rgba(197, 160, 89, 0.25);
    color: #c5a059;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
    z-index: 10;
  }

  .lwj-modal-close:hover {
    background: rgba(197, 160, 89, 0.15);
    border-color: #c5a059;
    color: #ffffff;
    transform: rotate(90deg);
  }

  .lwj-modal-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .lwj-modal-eyebrow {
    font-size: 10.5px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #c5a059;
    font-weight: 600;
    margin-bottom: 10px;
    display: block;
  }

  .lwj-modal-title {
    font-family: var(--g-font-2), "Cormorant Garamond", "Times New Roman", serif;
    font-size: 30px;
    font-weight: 400;
    color: #ffffff;
    margin: 0 0 10px 0;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .lwj-modal-desc {
    font-size: 13px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 auto;
    max-width: 480px;
    font-weight: 300;
  }

  /* Form Elements */
  .lwj-modal-form {
    width: 100%;
  }

  .lwj-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .lwj-field-group {
    display: flex;
    flex-direction: column;
  }

  .lwj-field-group.full-width {
    grid-column: 1 / -1;
  }

  .lwj-label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c5a059;
    font-weight: 500;
    margin-bottom: 7px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .lwj-req {
    color: #e07070;
  }

  .lwj-input,
  .lwj-textarea {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(197, 160, 89, 0.25);
    border-radius: 2px;
    color: #ffffff;
    font-family: inherit;
    font-size: 13.5px;
    padding: 12px 14px;
    box-sizing: border-box;
    transition: all 0.3s ease;
    outline: none;
  }

  .lwj-input::placeholder,
  .lwj-textarea::placeholder {
    color: rgba(255, 255, 255, 0.35);
    font-size: 12.5px;
  }

  .lwj-input:focus,
  .lwj-textarea:focus {
    border-color: #c5a059;
    background-color: rgba(255, 255, 255, 0.06);
    box-shadow: 0 0 12px rgba(197, 160, 89, 0.22);
  }

  .lwj-textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.5;
  }

  .lwj-form-footer {
    margin-top: 24px;
    display: flex;
    justify-content: center;
  }

  .lwj-submit-form-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    background: linear-gradient(135deg, #c5a059 0%, #a47e38 100%);
    color: #000000;
    border: none;
    border-radius: 2px;
    padding: 15px 30px;
    font-size: 11.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.35s ease;
    font-family: inherit;
  }

  .lwj-submit-form-btn:hover {
    background: linear-gradient(135deg, #d8b26a 0%, #b88f45 100%);
    box-shadow: 0 4px 20px rgba(197, 160, 89, 0.4);
    transform: translateY(-2px);
  }

  .lwj-submit-form-btn:active {
    transform: translateY(0);
  }

  /* Form Status */
  .lwj-form-errors {
    background: rgba(224, 112, 112, 0.12);
    border: 1px solid rgba(224, 112, 112, 0.4);
    color: #ff8b8b;
    padding: 14px 18px;
    font-size: 13px;
    border-radius: 3px;
    margin-bottom: 20px;
  }

  .lwj-form-success {
    text-align: center;
    padding: 20px 10px;
  }

  .lwj-success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(197, 160, 89, 0.12);
    border: 1px solid #c5a059;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px auto;
  }

  .lwj-btn-secondary {
    margin-top: 24px;
    display: inline-block;
    background: transparent;
    color: #c5a059;
    border: 1px solid rgba(197, 160, 89, 0.4);
    padding: 12px 28px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.3s ease;
    font-family: inherit;
  }

  .lwj-btn-secondary:hover {
    background: rgba(197, 160, 89, 0.15);
    border-color: #c5a059;
    color: #ffffff;
  }

  /* Responsive Adjustments */
  @media (max-width: 1199px) {
    .lwj-grid-frame {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .lwj-featured-card {
      min-height: 380px;
      padding: 40px 30px;
    }
    .lwj-featured-title {
      font-size: 30px;
    }
  }

  @media (max-width: 991px) {
    .lumina-journal-section { padding: 50px 0; }
    .lwj-container { padding: 0 20px; }
    .lwj-right-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto;
    }
  }

  @media (max-width: 600px) {
    .lwj-modal-container {
      padding: 36px 20px 24px 20px;
    }
    .lwj-form-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .lwj-modal-title {
      font-size: 24px;
    }
  }

  @media (max-width: 575px) {
    .lwj-right-grid {
      grid-template-columns: 1fr;
    }
    .lwj-featured-card {
      min-height: 340px;
      padding: 30px 20px;
    }
    .lwj-featured-title {
      font-size: 26px;
    }
  }
</style>

{%- liquid
  assign feat_art = section.settings.featured_article
  
  if feat_art != blank
    assign feat_title = feat_art.title
    assign feat_url = feat_art.url
    assign feat_image = feat_art.image
    if feat_image == blank
      assign feat_image = section.settings.featured_image
    endif
    assign feat_excerpt = section.settings.featured_excerpt
    if feat_excerpt == blank
      assign feat_excerpt = feat_art.excerpt_or_content | strip_html | truncate: 140
    endif
    assign feat_category = section.settings.featured_category
    if feat_category == blank and feat_art.tags.size > 0
      assign feat_category = feat_art.tags.first
    endif
    if feat_category == blank
      assign feat_category = "SCIENCE"
    endif
  else
    assign feat_title = section.settings.featured_title | default: "Exosomes: Nature's Messengers of Renewal"
    assign feat_url = section.settings.featured_link | default: "#"
    assign feat_image = section.settings.featured_image
    assign feat_excerpt = section.settings.featured_excerpt | default: "The tiny vesicles that may hold the key to communication, repair and radiant skin."
    assign feat_category = section.settings.featured_category | default: "SCIENCE"
  endif
-%}

<div id="journal" class="lumina-journal-section">
  <div class="lwj-container">

    <!-- Header Bar -->
    <div class="lwj-header-bar">
      {%- if section.settings.section_title != blank -%}
        <div class="lwj-header-label">{{ section.settings.section_title }}</div>
      {%- endif -%}

      {%- if section.settings.explore_label != blank -%}
        <a href="{{ section.settings.explore_link | default: '/blogs/news' }}" class="lwj-explore-link">
          {{ section.settings.explore_label }} &rarr;
        </a>
      {%- endif -%}
    </div>

    <!-- Journal Grid Layout -->
    <div class="lwj-grid-frame">

      <!-- LEFT FEATURED CARD -->
      <a href="{{ feat_url | default: '#' }}" class="lwj-featured-card">
        {%- if feat_image != blank -%}
          <img src="{{ feat_image | image_url: width: 1000 }}" alt="{{ feat_title | escape }}" class="lwj-card-bg" loading="lazy">
        {%- else -%}
          <img src="{{ 'lumina-world-hero-4.png' | asset_url }}" alt="{{ feat_title | escape }}" class="lwj-card-bg" loading="lazy">
        {%- endif -%}

        <div class="lwj-card-overlay"></div>

        <div class="lwj-featured-content">
          {%- if feat_category != blank -%}
            <span class="lwj-category">{{ feat_category }}</span>
          {%- endif -%}

          {%- if feat_title != blank -%}
            <h2 class="lwj-featured-title">{{ feat_title }}</h2>
          {%- endif -%}

          {%- if feat_excerpt != blank -%}
            <p class="lwj-excerpt">{{ feat_excerpt }}</p>
          {%- endif -%}

          <div class="lwj-read-link">
            READ ARTICLE
            <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </div>
        </div>
      </a>

      <!-- RIGHT 6 CARDS GRID -->
      <div class="lwj-right-grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign art = block.settings.article
            
            if art != blank
              assign card_title = art.title
              assign card_url = art.url
              assign card_image = art.image
              if card_image == blank
                assign card_image = block.settings.image
              endif
              assign card_category = block.settings.category
              if card_category == blank and art.tags.size > 0
                assign card_category = art.tags.first
              endif
              if card_category == blank
                assign card_category = "JOURNAL"
              endif
            else
              assign card_title = block.settings.title | default: "Article Title"
              assign card_url = block.settings.link | default: "#"
              assign card_image = block.settings.image
              assign card_category = block.settings.category | default: "JOURNAL"
            endif
          -%}

          <a href="{{ card_url | default: '#' }}" class="lwj-mini-card" {{ block.shopify_attributes }}>
            {%- if card_image != blank -%}
              <img src="{{ card_image | image_url: width: 600 }}" alt="{{ card_title | escape }}" class="lwj-card-bg" loading="lazy">
            {%- else -%}
              {%- assign journal_img_mod = forloop.index | modulo: 5 | plus: 1 -%}
              {%- assign fallback_journal_img = 'lumina-world-hero-' | append: journal_img_mod | append: '.png' -%}
              <img src="{{ fallback_journal_img | asset_url }}" alt="{{ card_title | escape }}" class="lwj-card-bg" loading="lazy">
            {%- endif -%}

            <div class="lwj-card-overlay"></div>

            <div class="lwj-mini-card-top">
              {%- if card_category != blank -%}
                <span class="lwj-category">{{ card_category }}</span>
              {%- endif -%}
              {%- if card_title != blank -%}
                <h3 class="lwj-mini-title">{{ card_title }}</h3>
              {%- endif -%}
            </div>

            <div class="lwj-mini-card-bottom">
              <div class="lwj-read-link">
                READ ARTICLE
                <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>

    </div>

    <!-- Bottom Submit Journal Button -->
    {%- if section.settings.show_submission_btn != false -%}
      <div class="lwj-bottom-action">
        <button type="button" class="lwj-submit-journal-trigger" id="lwj-open-modal-btn">
          <span>{{ section.settings.submission_btn_text | default: "SUBMIT YOUR STORY" }}</span>
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>
    {%- endif -%}

  </div>
</div>

<!-- Modal Popup Form for Submitting Journal Story -->
<div id="LuminaJournalModal" class="lwj-modal-overlay" aria-hidden="true" style="display: none;">
  <div class="lwj-modal-container">
    <button type="button" class="lwj-modal-close" id="lwj-modal-close-btn" aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    {% form 'contact', id: 'LuminaJournalSubmissionForm', class: 'lwj-modal-form' %}
      <input type="hidden" name="contact[Tip Formular]" value="Article Submission / Journal Story - Lumina World">

      {%- if form.posted_successfully? -%}
        <div class="lwj-form-success">
          <div class="lwj-success-icon">
            <svg viewBox="0 0 24 24" width="34" height="34" stroke="#c5a059" stroke-width="2" fill="none">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <span class="lwj-modal-eyebrow">MARKEU S.R.L. / LUMINA WORLD</span>
          <h3 class="lwj-modal-title">Thank you for sharing your story!</h3>
          <p class="lwj-modal-desc">
            Your story submission has been received with appreciation. Our editorial team will review your piece and reach out via email.
          </p>
          <button type="button" class="lwj-btn-secondary" id="lwj-success-close-btn">
            Back to Journal
          </button>
        </div>
      {%- else -%}
        <div class="lwj-modal-header">
          <span class="lwj-modal-eyebrow">{{ section.settings.modal_eyebrow | default: "JOIN THE JOURNAL" }}</span>
          <h3 class="lwj-modal-title">{{ section.settings.modal_title | default: "Submit Your Story" }}</h3>
          <p class="lwj-modal-desc">
            {{ section.settings.modal_desc | default: "Share your own perspective, experience or research to be published in Lumina Journal." }}
          </p>
        </div>

        {%- if form.errors -%}
          <div class="lwj-form-errors">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="lwj-form-grid">
          <div class="lwj-field-group">
            <label class="lwj-label" for="lwj-name">Full Name <span class="lwj-req">*</span></label>
            <input type="text" id="lwj-name" name="contact[name]" class="lwj-input" placeholder="e.g. Maria Vance" required>
          </div>

          <div class="lwj-field-group">
            <label class="lwj-label" for="lwj-email">Email Address <span class="lwj-req">*</span></label>
            <input type="email" id="lwj-email" name="contact[email]" class="lwj-input" placeholder="e.g. maria@example.com" required>
          </div>

          <div class="lwj-field-group full-width">
            <label class="lwj-label" for="lwj-social">Social Media Profile (Instagram / LinkedIn etc.) <span class="lwj-req">*</span></label>
            <input type="text" id="lwj-social" name="contact[Profil Social Media]" class="lwj-input" placeholder="e.g. @maria.vance or https://instagram.com/..." required>
          </div>

          <div class="lwj-field-group full-width">
            <label class="lwj-label" for="lwj-title">Journal / Article Title <span class="lwj-req">*</span></label>
            <input type="text" id="lwj-title" name="contact[Journal Title]" class="lwj-input" placeholder="What is your story about?" required>
          </div>

          <div class="lwj-field-group full-width">
            <label class="lwj-label" for="lwj-story">Share your story for the journal <span class="lwj-req">*</span></label>
            <textarea id="lwj-story" name="contact[body]" rows="5" class="lwj-textarea" placeholder="Write your reflection, skincare ritual, or perspective you wish to share in the Journal..." required></textarea>
          </div>
        </div>

        <div class="lwj-form-footer">
          <button type="submit" class="lwj-submit-form-btn">
            <span>SUBMIT STORY</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      {%- endif -%}
    {% endform %}
  </div>
</div>

<script>
  (function() {
    function initJournalModal() {
      var openBtn = document.getElementById('lwj-open-modal-btn');
      var modal = document.getElementById('LuminaJournalModal');
      var closeBtn = document.getElementById('lwj-modal-close-btn');
      var successCloseBtn = document.getElementById('lwj-success-close-btn');
      
      if (!modal) return;

      function openModal() {
        modal.style.display = 'flex';
        // Force reflow
        void modal.offsetHeight;
        modal.classList.add('is-active');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        modal.classList.remove('is-active');
        modal.setAttribute('aria-hidden', 'true');
        setTimeout(function() {
          if (!modal.classList.contains('is-active')) {
            modal.style.display = 'none';
            document.body.style.overflow = '';
          }
        }, 350);
      }

      if (openBtn) {
        openBtn.addEventListener('click', function(e) {
          e.preventDefault();
          openModal();
        });
      }

      if (closeBtn) {
        closeBtn.addEventListener('click', function(e) {
          e.preventDefault();
          closeModal();
        });
      }

      if (successCloseBtn) {
        successCloseBtn.addEventListener('click', function(e) {
          e.preventDefault();
          closeModal();
        });
      }

      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          closeModal();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.classList.contains('is-active')) {
          closeModal();
        }
      });

      {% if form.posted_successfully? or form.errors %}
        openModal();
      {% endif %}
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initJournalModal);
    } else {
      initJournalModal();
    }
    document.addEventListener('shopify:section:load', initJournalModal);
  })();
</script>

