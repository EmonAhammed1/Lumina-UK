<style>
  #technology-why-nanofibre {
    padding: 80px 0;
    background-color: var(--color-bg, #000);
  }
  .tech-why-heading {
    text-align: center;
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 50px;
    color: var(--g-color-heading, #fff);
  }
  .tech-why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .tech-why-card {
    background-color: var(--card-bg, #111);
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .tech-why-card-image {
    width: 100%;
    padding-bottom: 70%;
    position: relative;
    overflow: hidden;
  }
  .tech-why-card-image img {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }
  .tech-why-card-content {
    padding: 30px;
    flex-grow: 1;
  }
  .tech-why-card-title {
    font-size: 1.25rem;
    margin-bottom: 15px;
    color: var(--g-color-heading, #fff);
  }
  .tech-why-card-text {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-body-text, #FAF6F0);
  }
  
  @media (min-width: 768px) {
    .tech-why-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .tech-why-card-content {
      padding: 40px;
    }
  }
</style>

<div id="technology-why-nanofibre" data-section-id="{{ section.id }}">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="tech-why-heading" data-aos="fade-up" data-aos-duration="700">{{ section.settings.heading }}</h2>
    {% endif %}
    
    <div class="tech-why-grid">
      {% for block in section.blocks %}
        <div class="tech-why-card" style="--card-bg: {{ block.settings.card_bg }};" data-aos="fade-up" data-aos-duration="700" data-aos-delay="{{ forloop.index | times: 100 }}" {{ block.shopify_attributes }}>
          <div class="tech-why-card-image">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {% else %}
              {% case forloop.index %}
                {% when 1 %}
                  <img src="{{ 'img-1.png' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                {% when 2 %}
                  <img src="{{ 'img-2.png' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                {% else %}
                  <img src="{{ 'img-3.png' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {% endcase %}
            {% endif %}
          </div>
          <div class="tech-why-card-content">
            <h3 class="tech-why-card-title">{{ block.settings.title }}</h3>
            <div class="tech-why-card-text">{{ block.settings.text }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Technology Why Nanofibers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Why Lumina Chose Nanofibers Technology"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Close-up Image"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card Background Color",
          "default": "#111111"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Precision"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Card Body",
          "info": "50-60 words max.",
          "default": "The formula is integrated into an ultra-fine structure designed for controlled activation and focused application."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Technology Why Nanofibers",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Precision",
            "text": "The formula is integrated into an ultra-fine structure designed for controlled activation and focused application."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Freshness Before Activation",
            "text": "The dry presentation keeps the ritual separate from water until the moment it is prepared for use."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "A Different Experience",
            "text": "Lightweight, delicate and transformative, the material creates a ritual unlike a conventional liquid-soaked sheet mask."
          }
        }
      ]
    }
  ]
}
{% endschema %}
