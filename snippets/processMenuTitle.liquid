{%- liquid
  assign raw_name = itemName
  if itemName contains '[' and itemName contains ']'
    assign raw_name = itemName | split: '[' | first
  endif
  assign clean_name = raw_name | strip
  assign name_dn = clean_name | downcase
  assign name_norm = name_dn | replace: 'ă', 'a' | replace: 'â', 'a' | replace: 'î', 'i' | replace: 'ș', 's' | replace: 'ş', 's' | replace: 'ț', 't' | replace: 'ţ', 't' | strip
  
  case name_norm
    # Column & Section Headings
    when 'descopera lumina', 'discover lumina'
      echo 'DISCOVER LUMINA'
    when 'colectii & ritualuri', 'collections & rituals', 'colectii si ritualuri', 'colectii ritualuri'
      echo 'COLLECTIONS & RITUALS'
    when 'ajutor & concierge', 'ajutor si concierge', 'ajutor', 'help & concierge', 'help and concierge', 'asistenta', 'asistenta clienti', 'suport', 'suport & concierge'
      echo 'HELP & CONCIERGE'
    when 'legal', 'termeni legali', 'informatii legale'
      echo 'LEGAL'
    when 'produse', 'products', 'produsele noastre'
      echo 'PRODUCTS'
    when 'ritualuri', 'rituals', 'ritualurile lumina'
      echo 'RITUALS'
    when 'lumea lumina', 'lumina world'
      echo 'LUMINA WORLD'

    # Tech & Science
    when 'what are nanofibres', 'what are nanofibers', 'ce sunt nanofibrele', 'ce sunt nanofibrele?'
      echo 'WHAT ARE NANOFIBERS'
    when 'technology and formula', 'technology & formula', 'tehnologie si formula', 'tehnologie', 'tehnologia nanofibrelor', 'nanofiber technology', 'tehnologie & inovatie'
      echo 'TECHNOLOGY & FORMULA'
    when 'how to use', 'how to use it', 'mod de utilizare', 'cum se foloseste', 'cum se utilizeaza', 'ghid de utilizare', 'instructiuni'
      echo 'HOW TO USE'
    when 'ritual synergies', 'sinergii de ritual', 'sinergii'
      echo 'RITUAL SYNERGIES'
    when 'scientific foundation and awards', 'scientific foundation & awards', 'scientific foundation', 'baza stiintifica si premii', 'baza stiintifica', 'premii', 'premii si certificari'
      echo 'SCIENTIFIC FOUNDATION & AWARDS'
    when 'active ingredients', 'ingrediente active', 'ingrediente', 'ingrediente cheie', 'formula'
      echo 'Active Ingredients'

    # Lumina World Subpages
    when 'conversations', 'conversatii', 'interviuri'
      echo 'Conversations'
    when 'articles', 'articole', 'articole jurnal'
      echo 'Articles'
    when 'blog', 'stiri', 'news'
      echo 'Blog'
    when 'journal', 'jurnal', 'jurnalul lumina', 'povesti'
      echo 'Journal'
    when 'films', 'film', 'filme', 'video', 'videoclipuri'
      echo 'Films'
    when 'gallery', 'galerie', 'galerie foto', 'fotografii'
      echo 'Gallery'
    when 'follow lumina', 'urmareste lumina', 'social media'
      echo 'Follow Lumina'
    when 'lumina golden hour', 'golden hour', 'ora de aur', 'membri golden hour'
      echo 'Lumina Golden Hour'

    # Products & Collections
    when 'collections', 'colectii', 'colectie', 'toate colectiile'
      echo 'Collections'
    when 'all products', 'toate produsele', 'toate produsele lumina', 'vezi toate produsele', 'toate'
      echo 'All Products'
    when 'masks with nanofibers', 'nanofiber masks', 'masti cu nanofibre', 'masti', 'colectie masti', 'masca nanofibre'
      echo 'Nanofiber Masks'
    when 'face sprays', 'sprayuri pentru fata', 'sprayuri', 'spray-uri', 'spray-uri faciale', 'spray de fata', 'hydro mist'
      echo 'Face Sprays'
    when 'sets & protocols', 'seturi & protocoale', 'seturi si protocoale', 'seturi', 'protocoale', 'bundles', 'pachete'
      echo 'Sets & Protocols'
    when 'bestsellers', 'bestsellere', 'cele mai vandute', 'popular'
      echo 'Best Sellers'
    when 'new arrivals', 'noutati', 'nou', 'produse noi'
      echo 'New Arrivals'

    # Rituals
    when 'morning ritual', 'ritualul de dimineata', 'ritual de dimineata', 'dimineata'
      echo 'Morning Ritual'
    when 'evening ritual', 'ritualul de seara', 'ritual de seara', 'seara'
      echo 'Evening Ritual'
    when 'express ritual', 'ritual rapid', 'ritualul rapid', 'rapid'
      echo 'Express Ritual'
    when 'seasonal rituals', 'ritualuri sezoniere', 'ritualuri de sezon'
      echo 'Seasonal Rituals'

    # Account & Help
    when 'my account', 'contul meu', 'cont', 'profil', 'intra in cont', 'autentificare'
      echo 'My Account'
    when 'my orders', 'comenzile mele', 'comenzi', 'istoric comenzi', 'urmarire comanda'
      echo 'My Orders'
    when 'returns', 'returns & refunds', 'retururi', 'retur', 'politica de retur', 'formular de retur', 'politica de retur si rambursare', 'returnari'
      echo 'Returns & Refunds'
    when 'shipping', 'shipping & delivery', 'shipping policy', 'livrare', 'politica de livrare', 'livrare si plata', 'livrare & plata', 'transport'
      echo 'Shipping Policy'
    when 'faq', 'faqs', 'intrebari frecvente', 'intrebari', 'intrebari si raspunsuri', 'centru de ajutor'
      echo 'Frequently Asked Questions'
    when 'contact', 'contact us', 'contacteaza-ne', 'contactati-ne', 'scrie-ne'
      echo 'Contact Us'

    # Legal & Company
    when 'about', 'about us', 'about lumina europa', 'despre noi', 'despre lumina europa', 'despre lumina', 'despre', 'povestea noastra'
      echo 'About Lumina Europa'
    when 'meet the team', 'our team', 'echipa noastra', 'echipa', 'the team', 'cine suntem'
      echo 'Our Team'
    when 'terms', 'terms of service', 'terms and conditions', 'termeni si conditii', 'termeni', 'termeni si conditii de utilizare', 'termeni de utilizare'
      echo 'Terms and Conditions'
    when 'privacy policy', 'politica de confidentialitate', 'confidentialitate', 'protectia datelor', 'gdpr'
      echo 'Privacy Policy'
    when 'cookie policy', 'politica cookies', 'cookies', 'politica de cookie', 'politica privind fisierele cookies', 'cookie-uri'
      echo 'Cookie Policy'
    when 'anpc', 'anpc.ro', 'protectia consumatorului', 'protectia consumatorilor', 'autoritatea nationala pentru protectia consumatorilor'
      echo 'Consumer Protection (ANPC)'
    when 'anpc - sal', 'sal', 'solutionarea alternativa a litigiilor'
      echo 'Alternative Dispute Resolution (SAL)'
    when 'anpc - sol', 'sol', 'solutionarea online a litigiilor'
      echo 'Online Dispute Resolution (SOL)'
    when 'sustainability', 'sustenabilitate', 'responsabilitate'
      echo 'Sustainability'
    when 'careers', 'cariere', 'cariera', 'alatura-te echipei'
      echo 'Careers'
    when 'home', 'acasa'
      echo 'Home'
    when 'lumina europa'
      echo 'LUMINA EUROPA'
    when 'collection', 'colectie'
      echo 'COLLECTION'
    when 'technology', 'tehnologie'
      echo 'TECHNOLOGY'
    when 'shop', 'magazin', 'catalog'
      echo 'Shop'
    when 'priority access', 'acces prioritar'
      echo 'Priority Access'
    when 'exclusive gifts', 'cadouri exclusive', 'cadouri'
      echo 'Exclusive Gifts'
    when 'curated offers', 'oferte dedicate', 'oferte'
      echo 'Curated Offers'
    when 'exclusive events', 'evenimente'
      echo 'Exclusive Events'
    when 'community', 'comunitate', 'comunitatea lumina'
      echo 'Lumina Community'
    else
      echo clean_name | escape
  endcase
-%}