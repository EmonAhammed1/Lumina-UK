          "settings": {
            "badge_number": "07",
            "category": "Products & Technology",
            "question": "Does the mask dissolve?",
            "answer": "<p> Depending on the specific product and formulation, the nanofiber structure is designed to transform during use as it comes into contact with the activation medium and the skin. Always follow the instructions provided with each individual product. </p>",
            "open_by_default": false
          }
        },
